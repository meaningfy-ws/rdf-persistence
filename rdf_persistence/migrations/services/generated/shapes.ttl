rp:AggregateKey a sh:NodeShape ;
	rdfs:comment "A key across aggregates, as the runtime reads it from the schema: no two aggregate roots of one class in a tenant's database hold the same values for its predicates." ;
	rdfs:label "Aggregate key" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n3 ;
	sh:property _:c14n18 , _:c14n39 , _:c14n43 ;
	sh:targetClass rp:AggregateKey .
rp:AggregateRoot a sh:NodeShape ;
	rdfs:comment "A mixin for classes whose instances are aggregate roots. Each instance is one named graph, whose IRI is derived from the root's IRI; it is versioned, loaded and saved as a whole." ;
	rdfs:label "Aggregate root" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n36 ;
	sh:targetClass rp:AggregateRoot .
rp:CommitMarker a sh:NodeShape ;
	rdfs:comment "The registry marker of one transaction's commit: a fresh IRI per transaction, written first in the single request, so the writes that follow apply only if it was written." ;
	rdfs:label "Commit marker" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n25 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n14 , _:c14n33 ;
	sh:targetClass rp:CommitMarker .
rp:Described a sh:NodeShape ;
	rdfs:comment "A mixin giving an object an IRI, a label and a description. The application writes them." ;
	rdfs:label "Described" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n11 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n0 , _:c14n19 , _:c14n34 ;
	sh:targetClass rp:Described .
rp:KeyDuplicate a sh:NodeShape ;
	rdfs:comment "A set of aggregate roots of one class that hold the same values for a key across aggregates, found in a tenant's database by the duplicates report." ;
	rdfs:label "Key duplicate" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n8 ;
	sh:property _:c14n17 , _:c14n31 , _:c14n6 , _:c14n9 ;
	sh:targetClass rp:KeyDuplicate .
rp:Migration a sh:NodeShape ;
	rdfs:comment "The reviewed file that moves the data of a database from one version of a schema to the next: the schema's id, the two versions and the steps, in order." ;
	rdfs:label "Migration" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n7 ;
	sh:property _:c14n1 , _:c14n26 , _:c14n27 , _:c14n30 , _:c14n40 ;
	sh:targetClass rp:Migration .
rp:MigrationStep a sh:NodeShape ;
	rdfs:comment "One step of a migration: three group graph patterns, as text, that the toolkit wraps into one update request over the graphs of a database. A step with `unresolved` is a draft and does not load." ;
	rdfs:label "Migration step" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n24 ;
	sh:property _:c14n12 , _:c14n20 , _:c14n29 , _:c14n35 , _:c14n42 ;
	sh:targetClass rp:MigrationStep .
rp:PendingLoad a sh:NodeShape ;
	rdfs:comment "The registry marker of a load not yet committed: one triple saying when the graph was put. It names no registry entry, so deleting it never deletes an entry." ;
	rdfs:label "Pending load" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n21 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n13 , _:c14n28 ;
	sh:targetClass rp:PendingLoad .
rp:Principal a sh:NodeShape ;
	rdfs:comment "A reference to a user account in the identity provider, by IRI only." ;
	rdfs:label "Principal" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n44 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n23 ;
	sh:targetClass prov:Agent .
rp:RegistryEntry a sh:NodeShape ;
	rdfs:comment "An entry of a tenant's registry graph, naming a graph that belongs to an aggregate. It is written by the session, never by the application." ;
	rdfs:label "Registry entry" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n10 ;
	sh:property _:c14n16 , _:c14n4 , _:c14n41 ;
	sh:targetClass rp:RegistryEntry .
rp:Tracked a sh:NodeShape ;
	rdfs:comment "A mixin for the tracking statements of a commit. The session writes them about the aggregate's graph IRI, never about the root entity." ;
	rdfs:label "Tracked" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n5 ;
	sh:property _:c14n15 , _:c14n32 , _:c14n37 , _:c14n38 ;
	sh:targetClass rp:Tracked .
