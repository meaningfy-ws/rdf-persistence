rp:Activity a sh:NodeShape ;
	rdfs:comment "Something that happened and generated or changed entities, carried out by principals." ;
	rdfs:label "Activity" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n22 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n12 , _:c14n3 , _:c14n36 , _:c14n39 , _:c14n79 ;
	sh:targetClass prov:Activity .
rp:Add a sh:NodeShape ;
	rdfs:comment "An activity that added an aggregate." ;
	rdfs:label "Add" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n58 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n44 , _:c14n64 , _:c14n67 , _:c14n69 , _:c14n76 ;
	sh:targetClass rp:Add .
rp:AggregateKey a sh:NodeShape ;
	rdfs:comment "A key across aggregates, as the runtime reads it from the schema: no two aggregate roots of one class in a tenant's database hold the same values for its predicates." ;
	rdfs:label "Aggregate key" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n14 ;
	sh:property _:c14n26 , _:c14n31 , _:c14n80 , _:c14n89 ;
	sh:targetClass rp:AggregateKey .
rp:AggregateRoot a sh:NodeShape ;
	rdfs:comment "A mixin for classes whose instances are aggregate roots. Each instance is one named graph, whose IRI is derived from the root's IRI; it is versioned, loaded and saved as a whole." ;
	rdfs:label "Aggregate root" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n68 ;
	sh:targetClass rp:AggregateRoot .
rp:BlobEntry a sh:NodeShape ;
	rdfs:comment "One object in a tenant's bucket, as a listing of the bucket reports it." ;
	rdfs:label "Blob entry" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n32 ;
	sh:property _:c14n55 , _:c14n71 ;
	sh:targetClass rp:BlobEntry .
rp:CommitMarker a sh:NodeShape ;
	rdfs:comment "The registry marker of one transaction's commit: a fresh IRI per transaction, written first in the single request, so the writes that follow apply only if it was written." ;
	rdfs:label "Commit marker" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n42 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n27 ;
	sh:targetClass rp:CommitMarker .
rp:DeleteFile a sh:NodeShape ;
	rdfs:comment "The activity of removing a stored file, with the file aggregate it used and an invalidation of it." ;
	rdfs:label "Delete file" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n88 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n37 , _:c14n46 , _:c14n73 , _:c14n75 , _:c14n85 , _:c14n86 ;
	sh:targetClass rp:DeleteFile .
rp:DependenceLink a sh:NodeShape ;
	rdfs:comment "One link of dependence read from the schema: the class of a dependent aggregate (its part) and the classes of the aggregate it points to (its whole), with the predicate of the pointer. Each side lists the class and its concrete subclasses." ;
	rdfs:label "Dependence link" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n48 ;
	sh:property _:c14n16 , _:c14n70 , _:c14n74 ;
	sh:targetClass rp:DependenceLink .
rp:Described a sh:NodeShape ;
	rdfs:comment "A mixin giving an object an IRI, a label and a description. The application writes them." ;
	rdfs:label "Described" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n24 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n0 , _:c14n33 ;
	sh:targetClass rp:Described .
rp:Generation a sh:NodeShape ;
