      },
      "skipped_blobs": {
         "@container": "@set",
         "@id": "skippedBlob"
      },
      "started_at": {
         "@type": "xsd:dateTime",
         "@id": "startedAt"
      },
      "state": {
         "@id": "state",
         "@type": "@vocab",
         "@context": {
            "active": "https://meaningfy.ws/ns/rdf-persistence#Active",
            "deleting": "https://meaningfy.ws/ns/rdf-persistence#Deleting"
         }
      },
      "target": {
         "@type": "@id",
         "@id": "ODRL:target"
      },
      "tenant": {
         "@type": "@id",
         "@id": "tenant"
      },
      "url_segment": {
         "@id": "urlSegment"
      },
