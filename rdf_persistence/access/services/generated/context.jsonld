      },
      "data_schema_version": {
         "@id": "dataSchemaVersion"
      },
      "description": {
         "@id": "dcterms:description"
      },
      "email": {
         "@id": "email"
      },
      "global_roles": {
         "@container": "@set",
         "@id": "globalRole"
      },
      "grants": {
         "@type": "@id",
