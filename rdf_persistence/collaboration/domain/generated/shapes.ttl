	sh:targetClass rp:UnderWorkflow .
rp:Workflow a sh:NodeShape ;
	rdfs:comment "The definition of a workflow, read from a file when the service starts and never stored: its name, its states, the state an aggregate starts in and the transitions between states. Its identifier is the IRI of the scheme whose concepts are the states, and it must stay stable once aggregates have states." ;
	rdfs:label "Workflow" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n141 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n1 , _:c14n124 , _:c14n162 , _:c14n33 , _:c14n40 ;
	sh:targetClass rp:Workflow .
rp:WorkflowTransition a sh:NodeShape ;
