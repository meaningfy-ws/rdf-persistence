rp:AggregateKey a sh:NodeShape ;
	rdfs:comment "A key across aggregates, as the runtime reads it from the schema: no two aggregate roots of one class in a tenant's database hold the same values for its predicates." ;
	rdfs:label "Aggregate key" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n28 ;
	sh:property _:c14n146 , _:c14n167 , _:c14n53 , _:c14n61 ;
	sh:targetClass rp:AggregateKey .
rp:AggregateRoot a sh:NodeShape ;
	rdfs:comment "A mixin for classes whose instances are aggregate roots. Each instance is one named graph, whose IRI is derived from the root's IRI; it is versioned, loaded and saved as a whole." ;
	rdfs:label "Aggregate root" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n127 ;
	sh:targetClass rp:AggregateRoot .
rp:Assignment a sh:NodeShape ;
	rdfs:comment "One change of the assignees of an aggregate, as an activity: which aggregate it used, which principals it added and which it removed, when and by whom. The toolkit stores it as the activity of the commit that changes the assignees, in the provenance graph, and keeps it when the aggregate is deleted. The payload slots belong to the command only: the stored record has none of them." ;
	rdfs:label "Assignment" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n62 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n107 , _:c14n115 , _:c14n117 , _:c14n136 , _:c14n137 , _:c14n142 , _:c14n3 , _:c14n6 , _:c14n75 , _:c14n89 ;
	sh:targetClass rp:Assignment .
rp:Comment a sh:NodeShape ;
	rdfs:comment "A remark on an aggregate, or a reply to another remark. Each comment is an aggregate root of its own, whose target is always the aggregate it is about; a reply also names the comment it answers. The toolkit writes and reads it, since its audience limits who may see it. The session writes its author and time as the tracking of its graph." ;
	rdfs:label "Comment" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n36 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n101 , _:c14n103 , _:c14n109 , _:c14n110 , _:c14n113 , _:c14n122 , _:c14n156 , _:c14n17 , _:c14n19 , _:c14n57 , _:c14n80 , _:c14n92 ;
	sh:targetClass <http://www.w3.org/ns/oa#Annotation> .
rp:CommitMarker a sh:NodeShape ;
	rdfs:comment "The registry marker of one transaction's commit: a fresh IRI per transaction, written first in the single request, so the writes that follow apply only if it was written." ;
	rdfs:label "Commit marker" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n84 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n54 ;
	sh:targetClass rp:CommitMarker .
rp:DependenceLink a sh:NodeShape ;
	rdfs:comment "One link of dependence read from the schema: the class of a dependent aggregate (its part) and the classes of the aggregate it points to (its whole), with the predicate of the pointer. Each side lists the class and its concrete subclasses." ;
	rdfs:label "Dependence link" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n94 ;
	sh:property _:c14n130 , _:c14n134 , _:c14n34 ;
	sh:targetClass rp:DependenceLink .
rp:Described a sh:NodeShape ;
	rdfs:comment "A mixin giving an object an IRI, a label and a description. The application writes them." ;
	rdfs:label "Described" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n49 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n0 , _:c14n64 ;
	sh:targetClass rp:Described .
rp:Generation a sh:NodeShape ;
	rdfs:comment "The generation of one version of an entity by an activity." ;
	rdfs:label "Generation" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n172 ;
