{
  "@context": "context.jsonld",
  "@omitGraph": true,
  "@embed": "@always",
  "@omitDefault": true,
  "@type": [
    "Activity",
    "PostComment",
    "Add",
    "Replace",
    "Remove",
    "Transition",
    "PostReply"
  ],
  "was_associated_with": {
    "@embed": "@never",
    "@omitDefault": true
  },
  "generations": {
    "@embed": "@always",
    "@omitDefault": true,
    "@type": "Generation"
  },
  "invalidations": {
    "@embed": "@always",
    "@omitDefault": true,
    "@type": "Invalidation"
  }
}
