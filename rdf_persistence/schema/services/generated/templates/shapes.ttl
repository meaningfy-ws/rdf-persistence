rp:KeyBranchTerms a sh:NodeShape ;
	rdfs:comment "The terms of one branch of the diagnosis, which are the key held terms and the claim's index." ;
	rdfs:label "Key branch terms" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n40 ;
	sh:property _:c14n1 , _:c14n18 , _:c14n3 , _:c14n35 , _:c14n36 , _:c14n38 , _:c14n39 ;
	sh:targetClass rp:KeyBranchTerms .
rp:KeyHeldTerms a sh:NodeShape ;
	rdfs:comment "The terms of the pattern that holds while another aggregate has the claimed values of a key." ;
	rdfs:label "Key held terms" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n29 ;
	sh:property _:c14n0 , _:c14n13 , _:c14n19 , _:c14n21 , _:c14n33 , _:c14n9 ;
	sh:targetClass rp:KeyHeldTerms .
rp:ListingTerms a sh:NodeShape ;
	rdfs:comment "The terms of the listing query over a tenant's registry." ;
	rdfs:label "Listing terms" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n10 ;
	sh:property _:c14n11 , _:c14n12 , _:c14n15 , _:c14n17 , _:c14n2 , _:c14n22 , _:c14n24 , _:c14n31 , _:c14n34 , _:c14n37 , _:c14n41 , _:c14n6 , _:c14n7 ;
	sh:targetClass rp:ListingTerms .
rp:OwnerTerms a sh:NodeShape ;
	rdfs:comment "The terms of the operations that drop what a root owns. It has no registry of its own, so it is not a `RegistryTerms`." ;
	rdfs:label "Owner terms" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n23 ;
	sh:property _:c14n14 , _:c14n16 , _:c14n20 , _:c14n26 ;
	sh:targetClass rp:OwnerTerms .
rp:RegistryTerms a sh:NodeShape ;
	rdfs:comment "The registry graph and the two predicates of its entries, shared by the templates that read it." ;
	rdfs:label "Registry terms" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n4 ;
	sh:property _:c14n28 , _:c14n30 , _:c14n32 ;
	sh:targetClass rp:RegistryTerms .
rp:StampGuardTerms a sh:NodeShape ;
	rdfs:comment "The terms that make a migration operation match only the stamp of the version it starts from." ;
	rdfs:label "Stamp guard terms" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n5 ;
