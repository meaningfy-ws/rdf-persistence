	sh:description "The messaging system, an OpenTelemetry development attribute (v1.45.0)." ;
	sh:maxCount 1 ;
	sh:name "Messaging system name" ;
	sh:nodeKind sh:Literal ;
	sh:order 26 ;
	sh:path rp:messagingSystemName .
