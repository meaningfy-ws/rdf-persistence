@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
rp:LogContext a sh:NodeShape ;
	rdfs:comment "The data of one step of an operation: the step and whatever else the call site knows. Only the step is required." ;
	rdfs:label "Log context" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n15 ;
	sh:property _:c14n0 , _:c14n1 , _:c14n10 , _:c14n11 , _:c14n12 , _:c14n13 , _:c14n14 , _:c14n16 , _:c14n17 , _:c14n18 , _:c14n19 , _:c14n2 , _:c14n20 , _:c14n21 , _:c14n22 , _:c14n23 , _:c14n24 , _:c14n25 , _:c14n26 , _:c14n27 , _:c14n28 , _:c14n3 , _:c14n4 , _:c14n5 , _:c14n6 , _:c14n7 , _:c14n8 , _:c14n9 ;
	sh:targetClass rp:LogContext .
_:c14n0 sh:datatype xsd:string ;
	sh:description "The class of an error, as `module.QualifiedName`, an OpenTelemetry stable attribute." ;
	sh:maxCount 1 ;
	sh:name "Error type" ;
	sh:nodeKind sh:Literal ;
	sh:order 24 ;
	sh:path rp:errorType .
