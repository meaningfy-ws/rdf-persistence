	sh:order 11 ;
	sh:path rp:resources .
_:c14n15 rdf:first rdf:type ;
	rdf:rest rdf:nil .
_:c14n16 sh:datatype xsd:string ;
	sh:description "The messaging destination, an OpenTelemetry development attribute (v1.45.0)." ;
	sh:maxCount 1 ;
	sh:name "Messaging destination name" ;
	sh:nodeKind sh:Literal ;
	sh:order 27 ;
	sh:path rp:messagingDestinationName .
_:c14n17 sh:datatype xsd:string ;
	sh:description "The step of the operation a record or a span stands for, one constant per call site." ;
