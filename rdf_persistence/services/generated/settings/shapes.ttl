@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
rp:DirectorySettings a sh:NodeShape ;
	rdfs:comment "How the user directory of the identity provider is read." ;
	rdfs:label "Directory settings" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n11 ;
	sh:property _:c14n29 ;
	sh:targetClass rp:DirectorySettings .
rp:EventSettings a sh:NodeShape ;
	rdfs:comment "The event bus, the relay that publishes from the outbox, and the hub that fans events out." ;
	rdfs:label "Event settings" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n28 ;
	sh:property _:c14n1 , _:c14n18 , _:c14n26 , _:c14n30 , _:c14n31 , _:c14n7 , _:c14n8 ;
	sh:targetClass rp:EventSettings .
rp:HttpSettings a sh:NodeShape ;
	rdfs:comment "The timeouts and the attempts of every HTTP client of the toolkit: the SPARQL store, the identity provider and the object store." ;
	rdfs:label "HTTP settings" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n3 ;
	sh:property _:c14n0 , _:c14n33 , _:c14n34 ;
	sh:targetClass rp:HttpSettings .
rp:JwksSettings a sh:NodeShape ;
	rdfs:comment "How the token verifier caches the identity provider's keys and which signatures it accepts." ;
	rdfs:label "JWKS settings" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n4 ;
	sh:property _:c14n14 , _:c14n2 , _:c14n20 , _:c14n22 ;
	sh:targetClass rp:JwksSettings .
rp:LimitSettings a sh:NodeShape ;
	rdfs:comment "The most the toolkit takes in one message bus run, one commit, one body and one restore manifest." ;
	rdfs:label "Limit settings" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n9 ;
	sh:property _:c14n10 , _:c14n13 , _:c14n23 , _:c14n35 ;
	sh:targetClass rp:LimitSettings .
rp:SseSettings a sh:NodeShape ;
	rdfs:comment "The lifetime, the access check, the keep-alive and the resume window of the events route." ;
	rdfs:label "Server-sent events settings" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n6 ;
	sh:property _:c14n15 , _:c14n21 , _:c14n24 , _:c14n5 ;
	sh:targetClass rp:SseSettings .
rp:ToolkitSettings a sh:NodeShape ;
	rdfs:comment "Every group of settings; each group is a new instance of its class with its own defaults, never absent." ;
	rdfs:label "Toolkit settings" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n32 ;
	sh:property _:c14n12 , _:c14n16 , _:c14n17 , _:c14n19 , _:c14n25 , _:c14n27 ;
	sh:targetClass rp:ToolkitSettings .
_:c14n0 sh:datatype xsd:float ;
	sh:defaultValue "5.0"^^xsd:float ;
	sh:description "The seconds an HTTP client waits to open a connection." ;
	sh:maxCount 1 ;
	sh:maxInclusive 31536000 ;
	sh:minCount 1 ;
	sh:minInclusive "0.001"^^xsd:double ;
	sh:name "Connect timeout" ;
	sh:nodeKind sh:Literal ;
	sh:order 0 ;
	sh:path rp:connect_timeout_seconds .
_:c14n1 sh:datatype xsd:float ;
	sh:defaultValue "30.0"^^xsd:float ;
	sh:description "The seconds a delivered event may stay unacknowledged before it is delivered again." ;
	sh:maxCount 1 ;
	sh:maxInclusive 31536000 ;
	sh:minCount 1 ;
	sh:minInclusive "0.001"^^xsd:double ;
	sh:name "Claim idle time" ;
	sh:nodeKind sh:Literal ;
	sh:order 2 ;
