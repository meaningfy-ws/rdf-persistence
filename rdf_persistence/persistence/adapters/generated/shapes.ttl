@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rp: <https://meaningfy.ws/ns/rdf-persistence#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
rp:FusekiDataset a sh:NodeShape ;
	rdfs:comment "One dataset of the Fuseki dataset list." ;
	rdfs:label "Fuseki dataset" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n0 ;
	sh:property _:c14n3 ;
	sh:targetClass rp:FusekiDataset .
rp:FusekiDatasetList a sh:NodeShape ;
	rdfs:comment "The answer of the Fuseki administration endpoint that lists datasets." ;
	rdfs:label "Fuseki dataset list" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n1 ;
	sh:property _:c14n2 ;
	sh:targetClass rp:FusekiDatasetList .
_:c14n0 rdf:first rdf:type ;
	rdf:rest rdf:nil .
_:c14n1 rdf:first rdf:type ;
	rdf:rest rdf:nil .
_:c14n2 sh:description "The datasets Fuseki serves." ;
	sh:minCount 1 ;
	sh:name "Fuseki datasets" ;
	sh:nodeKind sh:BlankNodeOrIRI ;
	sh:order 0 ;
	sh:path rp:fusekiDatasets .
_:c14n3 sh:datatype xsd:string ;
	sh:description "The name of the dataset, with a leading slash." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:name "Fuseki dataset name" ;
	sh:nodeKind sh:Literal ;
	sh:order 0 ;
	sh:path rp:fusekiDatasetName .
