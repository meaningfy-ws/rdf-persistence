	sh:name "Filter slot" ;
	sh:nodeKind sh:Literal ;
	sh:order 0 ;
	sh:path rp:filterSlot .
_:c14n30 sh:datatype xsd:integer ;
	sh:description "The position of the page's first object in the whole listing." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:minInclusive 0 ;
	sh:name "Offset" ;
	sh:nodeKind sh:Literal ;
	sh:order 3 ;
	sh:path rp:offset .
_:c14n31 sh:description "The IRI of the stored aggregate." ;
	sh:maxCount 1 ;
	sh:name "Head IRI" ;
	sh:nodeKind sh:IRI ;
	sh:order 0 ;
