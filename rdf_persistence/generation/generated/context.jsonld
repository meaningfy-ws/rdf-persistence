{
   "@context": {
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "linkml": {
         "@id": "linkmlVersion"
      },
      "rp": "https://meaningfy.ws/ns/rdf-persistence#",
      "schema": "http://schema.org/",
      "shex": "http://www.w3.org/ns/shex#",
      "skos": "http://www.w3.org/2004/02/skos/core#",
      "@vocab": "https://meaningfy.ws/ns/rdf-persistence#",
      "class_name": {
         "@id": "className"
      },
      "diagrams": {
         "@id": "diagramsFolder"
      },
      "inputs": {
         "@type": "@id",
         "@container": "@set",
         "@id": "manifestInputs"
      },
      "invalid": {
         "@container": "@set",
         "@id": "invalidInstances"
      },
      "kind": {
         "@id": "constraintKind",
         "@type": "@vocab",
         "@context": {
            "required": "https://meaningfy.ws/ns/rdf-persistence#ConstraintKindRequired",
            "cardinality": "https://meaningfy.ws/ns/rdf-persistence#ConstraintKindCardinality",
            "range_type": "https://meaningfy.ws/ns/rdf-persistence#ConstraintKindRangeType",
            "range_enum": "https://meaningfy.ws/ns/rdf-persistence#ConstraintKindRangeEnum",
            "pattern": "https://meaningfy.ws/ns/rdf-persistence#ConstraintKindPattern",
            "value_bounds": "https://meaningfy.ws/ns/rdf-persistence#ConstraintKindValueBounds",
            "identifier": "https://meaningfy.ws/ns/rdf-persistence#ConstraintKindIdentifier",
            "closed": "https://meaningfy.ws/ns/rdf-persistence#ConstraintKindClosed",
            "exactly_one_of": "https://meaningfy.ws/ns/rdf-persistence#ConstraintKindExactlyOneOf",
            "any_of": "https://meaningfy.ws/ns/rdf-persistence#ConstraintKindAnyOf",
            "unique_keys": "https://meaningfy.ws/ns/rdf-persistence#ConstraintKindUniqueKeys"
         }
      },
      "multivalued": {
         "@id": "multivalued"
      },
      "name": {
         "@id": "slotName"
      },
      "outputs": {
         "@type": "@id",
         "@container": "@set",
         "@id": "manifestOutputs"
      },
      "package": {
         "@id": "package"
      },
      "path": {
         "@id": "path"
      },
      "python": {
         "@id": "pythonFolder"
      },
      "range": {
         "@id": "range"
      },
      "required": {
         "@id": "required"
      },
      "schema_file": {
         "@id": "schemaFile"
      },
      "sha256": {
         "@id": "sha256"
      },
      "slots": {
         "@type": "@id",
         "@container": "@set",
         "@id": "slotShapes"
      },
      "typescript": {
         "@id": "typescriptFolder"
      },
      "valid": {
         "@container": "@set",
         "@id": "validInstances"
      },
      "@version": 1.1,
      "type": "@type",
      "ClassShape": {
         "@id": "ClassShape"
      },
      "ConstraintCase": {
         "@id": "ConstraintCase"
      },
      "GenerationManifest": {
         "@id": "GenerationManifest"
      },
      "GenerationTarget": {
         "@id": "GenerationTarget"
      },
      "ManifestEntry": {
         "@id": "ManifestEntry"
      },
      "SlotShape": {
         "@id": "SlotShape"
      }
   }
}
