	sh:name "TypeScript folder" ;
	sh:nodeKind sh:Literal ;
	sh:order 3 ;
	sh:path rp:typescriptFolder ;
	sh:pattern "^(?:^(?:[^/:\\\\.][^/:\\\\]*|\\.[^/:\\\\.][^/:\\\\]*|\\.\\.[^/:\\\\]+)(?:/(?:[^/:\\\\.][^/:\\\\]*|\\.[^/:\\\\.][^/:\\\\]*|\\.\\.[^/:\\\\]+))*$)(?![\\s\\S])" .
_:c14n15 sh:datatype xsd:string ;
	sh:description "The version of the `linkml` package that ran the generation." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:name "LinkML version" ;
	sh:nodeKind sh:Literal ;
	sh:order 0 ;
	sh:path rp:linkmlVersion .
_:c14n16 sh:description "The files a generation run wrote, sorted by path; not the manifest itself." ;
	sh:name "Outputs" ;
	sh:nodeKind sh:BlankNodeOrIRI ;
	sh:order 2 ;
	sh:path rp:manifestOutputs .
_:c14n17 sh:description "The kind of constraint a case exercises." ;
	sh:in _:c14n32 ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:name "Constraint kind" ;
	sh:order 0 ;
	sh:path rp:constraintKind .
_:c14n18 rdf:first rp:ConstraintKindUniqueKeys ;
