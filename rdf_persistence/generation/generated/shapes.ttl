@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
rp:ClassShape a sh:NodeShape ;
	rdfs:comment "The reviewed shape of one class, its name and the shape of each of its slots." ;
	rdfs:label "Class shape" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n19 ;
	sh:property _:c14n13 , _:c14n20 ;
	sh:targetClass rp:ClassShape .
rp:ConstraintCase a sh:NodeShape ;
	rdfs:comment "One row of the conformance table: a constraint kind, a class that declares it, and the instance files the generated class and shape must accept and refuse." ;
	rdfs:label "Constraint case" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n26 ;
	sh:property _:c14n10 , _:c14n17 , _:c14n3 , _:c14n36 ;
	sh:targetClass rp:ConstraintCase .
rp:GenerationManifest a sh:NodeShape ;
	rdfs:comment "What one generation run read and wrote: the installed `linkml` version, the files it read and the files it wrote. Written as `rp-manifest.json` in the target's Python folder." ;
	rdfs:label "Generation manifest" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n25 ;
	sh:property _:c14n12 , _:c14n15 , _:c14n16 ;
	sh:targetClass rp:GenerationManifest .
rp:GenerationTarget a sh:NodeShape ;
	rdfs:comment "One entry of the `[tool.rp-generate]` table of a `pyproject.toml`: a schema and the folders its generated artefacts are written to. Paths are relative to the folder of the `pyproject.toml`." ;
	rdfs:label "Generation target" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n11 ;
	sh:property _:c14n1 , _:c14n14 , _:c14n33 , _:c14n34 , _:c14n9 ;
	sh:targetClass rp:GenerationTarget .
rp:ManifestEntry a sh:NodeShape ;
	rdfs:comment "A file and the SHA-256 of its bytes, as recorded by a generation run." ;
	rdfs:label "Manifest entry" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n31 ;
	sh:property _:c14n0 , _:c14n21 ;
	sh:targetClass rp:ManifestEntry .
rp:SlotShape a sh:NodeShape ;
	rdfs:comment "The shape of one slot of a class, as the schema induces it." ;
	rdfs:label "Slot shape" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n22 ;
	sh:property _:c14n2 , _:c14n24 , _:c14n28 , _:c14n4 ;
	sh:targetClass rp:SlotShape .
_:c14n0 sh:datatype xsd:string ;
	sh:description "A file path, POSIX, relative to the folder of the `pyproject.toml`." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:name "Path" ;
	sh:nodeKind sh:Literal ;
	sh:order 0 ;
	sh:path rp:path ;
	sh:pattern "^(?:^(?:[^/:\\\\.][^/:\\\\]*|\\.[^/:\\\\.][^/:\\\\]*|\\.\\.[^/:\\\\]+)(?:/(?:[^/:\\\\.][^/:\\\\]*|\\.[^/:\\\\.][^/:\\\\]*|\\.\\.[^/:\\\\]+))*$)(?![\\s\\S])" .
_:c14n1 sh:datatype xsd:string ;
	sh:description "The folder that receives one Mermaid file per module; none are written when absent." ;
	sh:maxCount 1 ;
	sh:name "Diagrams folder" ;
	sh:nodeKind sh:Literal ;
	sh:order 4 ;
	sh:path rp:diagramsFolder ;
	sh:pattern "^(?:^(?:[^/:\\\\.][^/:\\\\]*|\\.[^/:\\\\.][^/:\\\\]*|\\.\\.[^/:\\\\]+)(?:/(?:[^/:\\\\.][^/:\\\\]*|\\.[^/:\\\\.][^/:\\\\]*|\\.\\.[^/:\\\\]+))*$)(?![\\s\\S])" .
_:c14n10 sh:datatype xsd:string ;
	sh:description "Paths of instance files, beside the cases file, that the class and the shape must accept." ;
	sh:name "Valid instances" ;
	sh:nodeKind sh:Literal ;
	sh:order 2 ;
	sh:path rp:validInstances .
_:c14n11 rdf:first rdf:type ;
	rdf:rest rdf:nil .
_:c14n12 sh:description "The files a generation run read, sorted by path." ;
	sh:name "Inputs" ;
	sh:nodeKind sh:BlankNodeOrIRI ;
	sh:order 1 ;
	sh:path rp:manifestInputs .
_:c14n13 sh:datatype xsd:string ;
	sh:description "The name of a class of the schema." ;
	sh:maxCount 1 ;
	sh:minCount 1 ;
	sh:name "Class name" ;
	sh:nodeKind sh:Literal ;
	sh:order 0 ;
	sh:path rp:className .
_:c14n14 sh:datatype xsd:string ;
	sh:description "The folder that receives the TypeScript types; none are written when absent." ;
