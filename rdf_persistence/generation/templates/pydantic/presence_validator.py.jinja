@model_validator(mode="after")
    def {{ method }}(self) -> "{{ class_name }}":
        held = [
            label
            for label, present in (
        {% for alternative in alternatives %}
                ({{ alternative.label | tojson }}, {{ alternative.holds }}),
        {% endfor %}
            )
            if present
        ]
        if {{ refused }}:
            raise ValueError(
                f"{{ class_name }}: {{ rule }} needs {{ need }} of [{{ labels }}], but {held or 'none'} hold"
            )
        return self
