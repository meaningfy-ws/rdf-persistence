// Generated by rp-generate from the schema module "{{ module.name }}". Do not edit.
{% for import in module.imports %}
import type { {{ import.names | join(", ") }} } from "./{{ import.module }}";
{% endfor %}
{% for enum in module.enums %}

{{ enum.doc }}
export type {{ enum.name }} =
{% for value in enum.values %}
  {{ value.doc }}
  | {{ value.literal }}{{ ";" if loop.last }}
{% endfor %}
{% endfor %}
{% for interface in module.interfaces %}

{{ interface.doc }}
export interface {{ interface.name }} {
{% for field in interface.fields %}
  {{ field.doc }}
  {{ field.name }}{{ "?" if field.optional }}: {{ field.type }};
{% endfor %}
}
{% endfor %}
