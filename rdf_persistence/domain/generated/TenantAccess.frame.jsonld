{
  "@context": "context.jsonld",
  "@omitGraph": true,
  "@embed": "@always",
  "@omitDefault": true,
  "@type": "TenantAccess",
  "grants": {
    "@embed": "@always",
    "@omitDefault": true,
    "@type": "Grant",
    "assignee": {
      "@embed": "@never",
      "@omitDefault": true
    }
  },
  "prohibitions": {
    "@embed": "@always",
    "@omitDefault": true,
    "@type": "Prohibition",
    "assignee": {
      "@embed": "@never",
      "@omitDefault": true
    }
  }
}
