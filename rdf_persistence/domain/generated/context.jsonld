         "@context": {
            "text": "skos:notation",
            "description": "skos:prefLabel",
            "meaning": "@id"
         },
         "@id": "kind"
      },
      "label": {
         "@id": "skos:prefLabel"
      },
      "level": {
         "@context": {
            "text": "skos:notation",
            "description": "skos:prefLabel",
            "meaning": "@id"
         },
         "@id": "level"
      },
      "loaded_graph": {
         "@type": "xsd:anyURI",
         "@id": "loadedGraph"
      },
      "media_type": {
         "@id": "mediaType"
      },
      "modified": {
         "@type": "xsd:dateTime",
         "@id": "dcterms:modified"
      },
      "owned_by": {
         "@type": "xsd:anyURI",
         "@id": "ownedBy"
      },
      "prohibitions": {
