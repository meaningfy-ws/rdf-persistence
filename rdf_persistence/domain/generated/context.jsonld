         "@context": {
            "text": "skos:notation",
            "description": "skos:prefLabel",
            "meaning": "@id"
         },
         "@id": "state"
      },
      "target": {
         "@type": "xsd:anyURI",
         "@id": "ODRL:target"
      },
      "uploaded": {
         "@type": "xsd:dateTime",
         "@id": "dcterms:dateSubmitted"
      },
      "uploaded_by": {
         "@type": "@id",
         "@id": "uploadedBy"
      },
      "version": {
         "@id": "version"
      },
