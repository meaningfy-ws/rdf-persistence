rp:AccountSummary a sh:NodeShape ;
	rdfs:comment "What the identity port reports about one account of the identity provider: its id, its login name, its email (a service account has none), whether it may sign in, and its global roles." ;
	rdfs:label "Account summary" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n30 ;
	sh:property _:c14n125 , _:c14n23 , _:c14n7 , _:c14n8 , _:c14n84 ;
	sh:targetClass rp:AccountSummary .
rp:AggregateRoot a sh:NodeShape ;
	rdfs:comment "A mixin for classes whose instances are aggregate roots. Each instance is one named graph, whose IRI is derived from the root's IRI; it is versioned, loaded and saved as a whole." ;
	rdfs:label "Aggregate root" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n110 ;
	sh:targetClass rp:AggregateRoot .
rp:Any a sh:NodeShape ;
	rdfs:comment "Any value; the slots that range over it hold data the toolkit does not model." ;
	rdfs:label "Any" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n151 ;
	sh:targetClass linkml:Any .
rp:Authorised a sh:NodeShape ;
	rdfs:comment "What a route's access check settled: the caller's principal, its access to the tenant, and the IRI of the tenant or aggregate it was checked on, which the route then acts on." ;
	rdfs:label "Authorised" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n54 ;
	sh:property _:c14n117 , _:c14n37 , _:c14n62 ;
	sh:targetClass rp:Authorised .
rp:CallerAccess a sh:NodeShape ;
	rdfs:comment "What the access check needs to know about one caller in one tenant: the tenant's state, and the grants and prohibitions of the access record that name the caller." ;
	rdfs:label "Caller access" ;
