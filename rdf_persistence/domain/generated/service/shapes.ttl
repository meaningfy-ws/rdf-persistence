@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
rp:AggregateRoot a sh:NodeShape ;
	rdfs:comment "A mixin for classes whose instances are aggregate roots. Each instance is one named graph, whose IRI is derived from the root's IRI; it is versioned, loaded and saved as a whole." ;
	rdfs:label "Aggregate root" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n65 ;
	sh:targetClass rp:AggregateRoot .
rp:Any a sh:NodeShape ;
	rdfs:comment "Any value; the slots that range over it hold data the toolkit does not model." ;
	rdfs:label "Any" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n84 ;
	sh:targetClass linkml:Any .
rp:Described a sh:NodeShape ;
	rdfs:comment "A mixin giving an object an IRI, a label and a description. The application writes them." ;
	rdfs:label "Described" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n23 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n0 , _:c14n31 , _:c14n64 ;
	sh:targetClass rp:Described .
rp:Grant a sh:NodeShape ;
	rdfs:comment "A permission given to a principal on a tenant or on one aggregate, either by role or as a direct action; exactly one of role and action is given." ;
	rdfs:label "Grant" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n54 ;
	sh:property _:c14n14 , _:c14n48 , _:c14n56 , _:c14n71 ;
	sh:targetClass odrl:Permission ;
	sh:xone _:c14n21 .
rp:GrantSet a sh:NodeShape ;
	rdfs:comment "The body that replaces the grants and prohibitions of a tenant; two grants with the same assignee, target and role or action are refused." ;
	rdfs:label "Grant set" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n75 ;
	sh:property _:c14n2 , _:c14n73 ;
	sh:sparql _:c14n4 ;
	sh:targetClass rp:GrantSet .
rp:LabelUpdate a sh:NodeShape ;
	rdfs:comment "The body that replaces the label of a tenant." ;
	rdfs:label "Label update" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n83 ;
	sh:property _:c14n6 ;
	sh:targetClass rp:LabelUpdate .
rp:Page a sh:NodeShape ;
	rdfs:comment "One page of a listing, with the position of the page in the whole listing." ;
	rdfs:label "Page" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n45 ;
	sh:property _:c14n17 , _:c14n79 , _:c14n81 , _:c14n89 ;
	sh:targetClass rp:Page .
rp:Policy a sh:NodeShape ;
	rdfs:comment "A set of permissions and prohibitions." ;
	rdfs:label "Policy" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n67 ;
	sh:targetClass odrl:Set .
rp:Principal a sh:NodeShape ;
	rdfs:comment "A reference to a user account in the identity provider, by IRI only." ;
	rdfs:label "Principal" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n92 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n39 ;
	sh:targetClass prov:Agent .
rp:Problem a sh:NodeShape ;
	rdfs:comment "An RFC 9457 problem detail, the body of every error answer of the service." ;
	rdfs:label "Problem" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n85 ;
	sh:property _:c14n13 , _:c14n36 , _:c14n42 , _:c14n49 , _:c14n88 ;
	sh:targetClass rp:Problem .
rp:Prohibition a sh:NodeShape ;
	rdfs:comment "The ODRL prohibition that forbids an assignee an action on a target; it wins over any permission." ;
	rdfs:label "Prohibition" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n53 ;
	sh:property _:c14n10 , _:c14n61 , _:c14n90 ;
	sh:targetClass odrl:Prohibition .
rp:RegistryEntry a sh:NodeShape ;
	rdfs:comment "An entry of a tenant's registry graph, naming a graph that belongs to an aggregate. It is written by the session, never by the application." ;
	rdfs:label "Registry entry" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n22 ;
	sh:property _:c14n12 , _:c14n28 , _:c14n86 ;
	sh:targetClass rp:RegistryEntry .
rp:RoleDefinition a sh:NodeShape ;
	rdfs:comment "What a role may do and where it applies. An application supplies its role definitions as data; they are not stored." ;
	rdfs:label "Role definition" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n60 ;
	sh:property _:c14n26 , _:c14n38 , _:c14n68 ;
	sh:targetClass rp:RoleDefinition .
rp:Rule a sh:NodeShape ;
	rdfs:comment "An ODRL rule that gives an assignee a ruling on an action over a target." ;
	rdfs:label "Rule" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n20 ;
	sh:property _:c14n30 , _:c14n33 , _:c14n51 ;
	sh:targetClass odrl:Rule .
rp:ServiceSettings a sh:NodeShape ;
	rdfs:comment "The settings of `install_service`: where the service is mounted, how it names tenants and which role its callers get on a tenant they create." ;
	rdfs:label "Service settings" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n80 ;
	sh:property _:c14n16 , _:c14n3 , _:c14n58 , _:c14n78 , _:c14n9 ;
	sh:targetClass rp:ServiceSettings .
rp:TenantAccess a sh:NodeShape ;
	rdfs:comment "The access record of a tenant: its label, state and database name, with the grants and prohibitions that say who may do what in it." ;
	rdfs:label "Tenant access" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n66 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n15 , _:c14n46 , _:c14n50 , _:c14n63 , _:c14n74 , _:c14n87 , _:c14n91 ;
	sh:sparql _:c14n5 ;
	sh:targetClass rp:TenantAccess .
rp:TenantCreate a sh:NodeShape ;
	rdfs:comment "The body that creates a tenant, its label and the slots of the tenant's root object." ;
	rdfs:label "Tenant create" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n55 ;
	sh:property _:c14n25 , _:c14n77 ;
	sh:targetClass rp:TenantCreate .
rp:TenantLabelled a sh:NodeShape ;
	rdfs:comment "A mixin for what carries a tenant's label, one line of 1 to 200 characters; the access record and the service's request bodies share it, so the label is checked the same everywhere." ;
	rdfs:label "Tenant labelled" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n41 ;
	sh:property _:c14n47 ;
	sh:targetClass rp:TenantLabelled .
rp:TenantSummary a sh:NodeShape ;
	rdfs:comment "What the service answers about one tenant, in a listing or after creating it." ;
	rdfs:label "Tenant summary" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n11 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n32 , _:c14n43 , _:c14n76 ;
	sh:targetClass rp:TenantSummary .
rp:Tracked a sh:NodeShape ;
	rdfs:comment "A mixin for the tracking statements of a commit. The session writes them about the aggregate's graph IRI, never about the root entity." ;
	rdfs:label "Tracked" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n18 ;
	sh:property _:c14n27 , _:c14n59 , _:c14n69 , _:c14n70 ;
	sh:targetClass rp:Tracked .
rp:VerifiedCaller a sh:NodeShape ;
	rdfs:comment "What a token verifier returns for a valid token, the principal and its global roles." ;
