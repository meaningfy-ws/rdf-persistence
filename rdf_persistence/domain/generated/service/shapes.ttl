	sh:closed true ;
	sh:ignoredProperties _:c14n150 ;
	sh:property _:c14n144 ;
	sh:targetClass rp:LabelUpdate .
rp:ListPlan a sh:NodeShape ;
	rdfs:comment "A listing resolved against the slots of the listed type: the class, the typed conditions, the predicate to order by (none orders by IRI), the page, and the graphs of the aggregates the caller may not read." ;
