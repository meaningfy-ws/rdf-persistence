	sh:ignoredProperties _:c14n9 ;
	sh:property _:c14n118 , _:c14n6 , _:c14n60 , _:c14n99 ;
	sh:sparql _:c14n5 ;
	sh:targetClass rp:CallerAccess .
rp:Condition a sh:NodeShape ;
	rdfs:comment "An equality filter of a listing resolved against the slots of the listed type: the aggregate has this statement. The value is an IRI when it is a reference, else a literal of the datatype." ;
	rdfs:label "Condition" ;
