	sh:ignoredProperties _:c14n38 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n0 , _:c14n109 , _:c14n50 ;
	sh:targetClass rp:Described .
rp:Filter a sh:NodeShape ;
	rdfs:comment "One equality filter of a listing, the name of a slot of the listed type and the value it must have, as the text the caller sent." ;
	rdfs:label "Filter" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n18 ;
	sh:property _:c14n119 , _:c14n19 ;
	sh:targetClass rp:Filter .
rp:Grant a sh:NodeShape ;
	rdfs:comment "A permission given to a principal on a tenant or on one aggregate, either by role or as a direct action; exactly one of role and action is given." ;
	rdfs:label "Grant" ;
