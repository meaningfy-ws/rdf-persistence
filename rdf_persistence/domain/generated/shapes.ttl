rp:StoredFile a sh:NodeShape ;
	rdfs:comment "A mixin for the current content of a kept file; the bytes live in the tenant's bucket under the file key." ;
	rdfs:label "Stored file" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n60 ;
