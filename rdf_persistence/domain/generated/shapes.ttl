	rdfs:label "Provenanced" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n55 ;
	sh:property _:c14n26 , _:c14n62 , _:c14n65 , _:c14n75 ;
	sh:targetClass rp:Provenanced .
rp:ReferenceCollection a sh:NodeShape ;
	rdfs:comment "A mixin for an aggregate that collects other aggregates of one class: the members it names, and a rule that says which aggregates of that class belong. A collection of collections has the collection class as its member class." ;
	rdfs:label "Reference collection" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n7 ;
	sh:property _:c14n4 , _:c14n45 , _:c14n49 ;
	sh:targetClass prov:Collection .
rp:RegistryEntry a sh:NodeShape ;
	rdfs:comment "An entry of a tenant's registry graph, naming a graph that belongs to an aggregate. It is written by the session, never by the application." ;
	rdfs:label "Registry entry" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n24 ;
	sh:property _:c14n104 , _:c14n12 , _:c14n34 ;
	sh:targetClass rp:RegistryEntry .
rp:RoleDefinition a sh:NodeShape ;
	rdfs:comment "What a role may do and where it applies. An application supplies its role definitions as data; they are not stored." ;
	rdfs:label "Role definition" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n80 ;
	sh:property _:c14n102 , _:c14n30 , _:c14n94 ;
