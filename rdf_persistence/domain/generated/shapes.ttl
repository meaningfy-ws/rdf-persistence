rp:Activity a sh:NodeShape ;
	rdfs:comment "Something that happened and generated or changed entities, carried out by principals." ;
	rdfs:label "Activity" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n28 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n120 , _:c14n47 ;
	sh:targetClass prov:Activity .
rp:AggregateKey a sh:NodeShape ;
	rdfs:comment "A key across aggregates, as the runtime reads it from the schema: no two aggregate roots of one class in a tenant's database hold the same values for its predicates." ;
	rdfs:label "Aggregate key" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n13 ;
	sh:property _:c14n110 , _:c14n122 , _:c14n42 ;
	sh:targetClass rp:AggregateKey .
rp:AggregateRoot a sh:NodeShape ;
	rdfs:comment "A mixin for classes whose instances are aggregate roots. Each instance is one named graph, whose IRI is derived from the root's IRI; it is versioned, loaded and saved as a whole." ;
	rdfs:label "Aggregate root" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n101 ;
	sh:targetClass rp:AggregateRoot .
rp:BlobEntry a sh:NodeShape ;
	rdfs:comment "One object in a tenant's bucket, as a listing of the bucket reports it." ;
	rdfs:label "Blob entry" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n43 ;
	sh:property _:c14n103 , _:c14n75 ;
	sh:targetClass rp:BlobEntry .
rp:Comment a sh:NodeShape ;
	rdfs:comment "A remark on an aggregate, or a reply to another remark. Each comment is an aggregate root of its own, whose target is always the aggregate it is about; a reply also names the comment it answers. The toolkit writes and reads it, since its audience limits who may see it. The session writes its author and time as the tracking of its graph." ;
	rdfs:label "Comment" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n18 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n108 , _:c14n114 , _:c14n115 , _:c14n46 , _:c14n57 , _:c14n66 , _:c14n7 , _:c14n72 , _:c14n80 , _:c14n87 , _:c14n96 ;
	sh:targetClass <http://www.w3.org/ns/oa#Annotation> .
rp:CommitMarker a sh:NodeShape ;
	rdfs:comment "The registry marker of one transaction's commit: a fresh IRI per transaction, written first in the single request, so the writes that follow apply only if it was written." ;
	rdfs:label "Commit marker" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n60 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n35 , _:c14n99 ;
	sh:targetClass rp:CommitMarker .
rp:Described a sh:NodeShape ;
	rdfs:comment "A mixin giving an object an IRI, a label and a description. The application writes them." ;
	rdfs:label "Described" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n30 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n0 , _:c14n100 , _:c14n45 ;
	sh:targetClass rp:Described .
rp:Grant a sh:NodeShape ;
	rdfs:comment "A permission given to a principal on a tenant or on one aggregate, either by role or as a direct action; exactly one of role and action is given." ;
	rdfs:label "Grant" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n81 ;
