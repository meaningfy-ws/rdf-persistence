rp:KeyDuplicate a sh:NodeShape ;
	rdfs:comment "A set of aggregate roots of one class that hold the same values for a key across aggregates, found in a tenant's database by the duplicates report." ;
	rdfs:label "Key duplicate" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n23 ;
	sh:property _:c14n20 , _:c14n25 , _:c14n38 , _:c14n88 ;
	sh:targetClass rp:KeyDuplicate .
rp:MembershipRule a sh:NodeShape ;
	rdfs:comment "The rule of a collection, a part of its graph with no identifier of its own. An aggregate belongs when it equals every equality; a rule with no equality means every aggregate of the member class." ;
	rdfs:label "Membership rule" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n112 ;
	sh:property _:c14n55 ;
	sh:targetClass rp:MembershipRule .
rp:PendingLoad a sh:NodeShape ;
	rdfs:comment "The registry marker of a load not yet committed: one triple saying when the graph was put. It names no registry entry, so deleting it never deletes an entry." ;
	rdfs:label "Pending load" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n48 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n34 , _:c14n70 ;
	sh:targetClass rp:PendingLoad .
rp:Policy a sh:NodeShape ;
	rdfs:comment "A set of permissions and prohibitions." ;
	rdfs:label "Policy" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n104 ;
	sh:targetClass odrl:Set .
rp:Principal a sh:NodeShape ;
	rdfs:comment "A reference to a user account in the identity provider, by IRI only." ;
	rdfs:label "Principal" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n125 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n58 ;
	sh:targetClass prov:Agent .
rp:Prohibition a sh:NodeShape ;
	rdfs:comment "The ODRL prohibition that forbids an assignee an action on a target; it wins over any permission." ;
	rdfs:label "Prohibition" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n79 ;
	sh:property _:c14n11 , _:c14n123 , _:c14n91 ;
