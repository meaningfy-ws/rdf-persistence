; =============================================================================
; Import Linter — architecture guardrails for RDF Persistence
; =============================================================================
; Run with:  make check-architecture   (wraps `uv run lint-imports`)
;
; Direction (PD-1, toolkit-v1-foundation), inside each of the thirteen themes (thematic-structure PD-6):
;   entrypoints | adapters  >  services  >  domain
; Ports live in `services`; their implementations in `adapters`. `entrypoints`
; and `adapters` are independent siblings: neither imports the other, so the
; consumer's composition root wires adapters in. Between the themes the order
; is `themes-ordered`. `testkit` sits outside the contracts, and
; `rdf_persistence_generation` is a separate root package the library never
; imports (library-never-imports-the-generator). Parenthesised layers are
; optional: a theme need not have every layer.

[importlinter]
root_packages =
    rdf_persistence
    rdf_persistence_generation
    tests
    rdflib
include_external_packages = True

; The thematic layout (thematic-structure PD-6). `themes-ordered` lists the highest theme first.
[importlinter:contract:themes-layered]
name = Themes: in each theme, entrypoints | adapters > services > domain, and nothing outside the layers
type = layers
containers =
    rdf_persistence.core
    rdf_persistence.iris
    rdf_persistence.schema
    rdf_persistence.files
    rdf_persistence.provenance
    rdf_persistence.persistence
    rdf_persistence.migrations
    rdf_persistence.access
    rdf_persistence.tenancy
    rdf_persistence.events
    rdf_persistence.collaboration
    rdf_persistence.messaging
    rdf_persistence.api
layers =
    (entrypoints) | (adapters)
    (services)
    (domain)
exhaustive = true

[importlinter:contract:themes-ordered]
name = Themes: a theme imports only the themes below it (core is the lowest)
type = layers
layers =
    rdf_persistence.api
    rdf_persistence.messaging
    rdf_persistence.collaboration | rdf_persistence.events
    rdf_persistence.tenancy
    rdf_persistence.access | rdf_persistence.migrations
    rdf_persistence.persistence
    rdf_persistence.files
    rdf_persistence.provenance
    rdf_persistence.iris | rdf_persistence.schema
    rdf_persistence.core

[importlinter:contract:domain-of-a-theme-imports-no-upper-layer]
name = layers-across-themes (1/4) the domain of a theme imports no services, adapters or entrypoints of any theme
type = forbidden
source_modules =
    rdf_persistence.*.domain
forbidden_modules =
    rdf_persistence.*.services
    rdf_persistence.*.adapters
    rdf_persistence.*.entrypoints

[importlinter:contract:services-of-a-theme-import-no-adapters-or-entrypoints]
name = layers-across-themes (2/4) the services of a theme import no adapters or entrypoints of any theme
type = forbidden
source_modules =
    rdf_persistence.*.services
forbidden_modules =
    rdf_persistence.*.adapters
    rdf_persistence.*.entrypoints

[importlinter:contract:adapters-and-entrypoints-of-themes-are-independent]
name = layers-across-themes (3/4) the adapters of the themes import no entrypoints
type = forbidden
source_modules =
    rdf_persistence.*.adapters
forbidden_modules =
    rdf_persistence.*.entrypoints

[importlinter:contract:entrypoints-of-themes-import-no-adapters]
name = layers-across-themes (4/4) the entrypoints of the themes import no adapters
type = forbidden
source_modules =
    rdf_persistence.*.entrypoints
forbidden_modules =
    rdf_persistence.*.adapters

; Technical models (service settings, wire shapes) sit in a `services`, `adapters` or `entrypoints`
; layer, which no domain imports (the first two of the four `layers-across-themes` contracts), nor does a domain import
; the testkit's (`runtime-without-extras`): that is what `domain-never-imports-technical-models` said
; (technical-models PD-2, Q-2; thematic-structure PD-6).
[importlinter:contract:domain-pure]
name = domain imports no I/O, web, token or validation library
type = forbidden
source_modules =
    rdf_persistence.*.domain
forbidden_modules =
    httpx
    boto3
    fastapi
    jwt
    pyshacl
    anyio

[importlinter:contract:runtime-without-extras]
name = runtime layers import neither the testkit, the generators nor test tooling
type = forbidden
source_modules =
    rdf_persistence.*.domain
    rdf_persistence.*.services
    rdf_persistence.*.adapters
    rdf_persistence.*.entrypoints
forbidden_modules =
    rdf_persistence.testkit
    rdf_persistence_generation
    pytest
    testcontainers
    linkml

[importlinter:contract:works-without-the-generate-extra]
name = what runs without the generate extra imports no linkml (only linkml_runtime)
; The freshness plugin, the manifest comparison, the configuration and the schema helpers are
; installed with the base package; the generators (the `generate` extra) are reached only through
; the lazy import in cli.py, which is ignored here so every other chain is checked.
type = forbidden
source_modules =
    rdf_persistence_generation.cli
    rdf_persistence_generation.config
    rdf_persistence_generation.manifest
    rdf_persistence_generation.pipeline
    rdf_persistence_generation.exceptions
    rdf_persistence_generation.module_cycles
    rdf_persistence_generation.problems
    rdf_persistence_generation.generated
    rdf_persistence_generation.testkit
    rdf_persistence_generation.uml
    rdf_persistence.testkit
    rdf_persistence.schema.services.schema
    rdf_persistence.schema.services.schema_structure
forbidden_modules =
    linkml
ignore_imports =
    rdf_persistence_generation.cli -> rdf_persistence_generation.steps

; The library never imports the generator (generator-package PD-8, DEC-3), with no exception: the
; four testkit shims were removed in 0.6.0 (#165).
[importlinter:contract:library-never-imports-the-generator]
name = the library never imports the generator
type = forbidden
source_modules =
    rdf_persistence
forbidden_modules =
    rdf_persistence_generation

[importlinter:contract:collaboration-layers]
name = the collaboration modules layer above the session: messagebus > collaboration > transitions | write_guards | referenced_removals > discussion | reference_collections | workflows | referrer_naming > access > session (PD-28, PD-32, review-floors PD-2)
; access sits above session, not beside it: it reaches the session through the mapper (access -> mapper -> session).
type = layers
layers =
    rdf_persistence.messaging.services.messagebus
    rdf_persistence.collaboration.services.collaboration
    rdf_persistence.collaboration.services.transitions | rdf_persistence.collaboration.services.write_guards | rdf_persistence.collaboration.services.referenced_removals
    rdf_persistence.collaboration.services.discussion | rdf_persistence.collaboration.services.reference_collections | rdf_persistence.collaboration.services.workflows | rdf_persistence.collaboration.services.referrer_naming
    rdf_persistence.access.services.access
    rdf_persistence.persistence.services.session
    rdf_persistence.persistence.services.referrers

[importlinter:contract:session-and-provenance-without-mapper]
name = the session and the activity shape never import the mapper, which imports the session (message-bus PD-6)
type = forbidden
source_modules =
    rdf_persistence.persistence.services.session
    rdf_persistence.provenance.services.provenance
forbidden_modules =
    rdf_persistence.persistence.services.mapper

[importlinter:contract:tenancy-without-the-runner]
name = the tenancy never imports the runner, which imports the tenancy (PD-24.2, PD-25.6)
type = forbidden
source_modules =
    rdf_persistence.tenancy.services.tenancy
forbidden_modules =
    rdf_persistence.tenancy.services.migration_runner

[importlinter:contract:event-bus-libraries-in-one-module]
name = only the Redis adapter imports faststream, and nothing imports redis (aggregate-events PD-8)
type = forbidden
source_modules =
    rdf_persistence
    rdf_persistence_generation
forbidden_modules =
    faststream
    redis
ignore_imports =
    rdf_persistence.events.adapters.redis_events -> faststream

; The theme order puts `api` above `messaging`, so it cannot keep the `api` services off the bus
; (thematic-structure D-23); this contract does, for the whole package, so a module added later is covered.
[importlinter:contract:api-services-never-import-the-bus]
name = the api services never import the message bus
type = forbidden
source_modules =
    rdf_persistence.api.services
forbidden_modules =
    rdf_persistence.messaging

[importlinter:contract:domain-tests-stay-in-the-domain]
name = the domain tests import nothing above the domain: no services, adapters, entrypoints, testkit or toy service
; Direct imports only: the package's public names (`from rdf_persistence import ...`) reach the upper layers in
; the package's own __init__, which the domain tests may use.
type = forbidden
allow_indirect_imports = True
source_modules =
    tests.unit.core.test_rp_model
    tests.unit.core.test_access_model
    tests.unit.core.test_tenant_store_name
    tests.unit.core.test_exceptions
    tests.unit.core.test_sparql
    tests.unit.core.test_sparql_parsing
    tests.unit.iris.test_layout
    tests.unit.files.test_blob_keys
forbidden_modules =
    rdf_persistence.*.services
    rdf_persistence.*.adapters
    rdf_persistence.*.entrypoints
    rdf_persistence.testkit
    tests.toy
    tests.toy_service

[importlinter:contract:tenant-move-test-imports-only-its-module]
name = the tenant-move test imports the module, the iris policy and the domain, nothing else
; It cannot join the domain-tests contract: it imports a services module and the iris policy on purpose.
type = forbidden
allow_indirect_imports = True
source_modules =
    tests.unit.tenancy.test_tenant_move
forbidden_modules =
    rdf_persistence.schema
    rdf_persistence.*.adapters
    rdf_persistence.*.entrypoints
    rdf_persistence.testkit
    tests.toy
    tests.toy_service

[importlinter:contract:sparql-parser-only-through-the-wrappers]
name = nothing imports rdflib.plugins.sparql or pyshacl but the wrappers
; rdflib is a root package above, so its submodules can be named; indirect chains through rdflib itself
; are fine, only a direct import counts.
type = forbidden
allow_indirect_imports = True
source_modules =
    rdf_persistence
    rdf_persistence_generation
forbidden_modules =
    rdflib.plugins.sparql
    pyshacl
ignore_imports =
    rdf_persistence.core.domain.sparql_parsing -> rdflib.plugins.sparql
    rdf_persistence.core.domain.sparql_parsing -> rdflib.plugins.sparql.**
    rdf_persistence.api.services.shacl -> pyshacl
