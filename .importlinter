; =============================================================================
; Import Linter — architecture guardrails for RDF Persistence
; =============================================================================
; Run with:  make check-architecture   (wraps `uv run lint-imports`)
;
; Direction (PD-1, toolkit-v1-foundation):
;   entrypoints | adapters  >  services  >  domain
; Ports live in `services`; their implementations in `adapters`. `entrypoints`
; and `adapters` are independent siblings: neither imports the other, so the
; consumer's composition root wires adapters in. `generation` and `testkit` sit
; outside the contract. Parenthesised layers are optional until they exist.

[importlinter]
root_package = rdf_persistence
include_external_packages = True

[importlinter:contract:layers]
name = Layers: entrypoints | adapters > services > domain
type = layers
layers =
    (rdf_persistence.entrypoints) | (rdf_persistence.adapters)
    (rdf_persistence.services)
    (rdf_persistence.domain)

[importlinter:contract:domain-pure]
name = domain imports no I/O, web, token or validation library
type = forbidden
source_modules =
    rdf_persistence.domain
forbidden_modules =
    httpx
    boto3
    fastapi
    jwt
    pyshacl
    anyio

[importlinter:contract:runtime-without-extras]
name = runtime layers import neither the testkit, the generators nor test tooling
type = forbidden
source_modules =
    rdf_persistence.domain
    rdf_persistence.services
    rdf_persistence.adapters
    rdf_persistence.entrypoints
forbidden_modules =
    rdf_persistence.testkit
    rdf_persistence.generation
    pytest
    testcontainers
    linkml

[importlinter:contract:works-without-the-generate-extra]
name = what runs without the generate extra imports no linkml (only linkml_runtime)
; The freshness plugin, the manifest comparison, the configuration and the schema helpers are
; installed with the base package; the generators (the `generate` extra) are reached only through
; the lazy import in cli.py, which is ignored here so every other chain is checked.
type = forbidden
source_modules =
    rdf_persistence.testkit
    rdf_persistence.generation.cli
    rdf_persistence.generation.config
    rdf_persistence.generation.manifest
    rdf_persistence.generation.pipeline
    rdf_persistence.generation.exceptions
    rdf_persistence.generation.generated
    rdf_persistence.services.schema
    rdf_persistence.services.schema_structure
forbidden_modules =
    linkml
ignore_imports =
    rdf_persistence.generation.cli -> rdf_persistence.generation.steps

[importlinter:contract:collaboration-layers]
name = the collaboration modules layer above the session: collaboration > transitions | write_guards > discussion | reference_collections | workflows > access > session (PD-28, PD-32)
; access sits above session, not beside it: it reaches the session through the mapper (access -> mapper -> session).
type = layers
layers =
    rdf_persistence.services.collaboration
    rdf_persistence.services.transitions | rdf_persistence.services.write_guards
    rdf_persistence.services.discussion | rdf_persistence.services.reference_collections | rdf_persistence.services.workflows
    rdf_persistence.services.access
    rdf_persistence.services.session
