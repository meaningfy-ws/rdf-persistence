; =============================================================================
; Import Linter — architecture guardrails for RDF Persistence
; =============================================================================
; Run with:  make check-architecture   (wraps `uv run lint-imports`)
;
; Direction (PD-1, toolkit-v1-foundation):
;   entrypoints | adapters  >  services  >  domain
; Ports live in `services`; their implementations in `adapters`. `entrypoints`
; and `adapters` are independent siblings: neither imports the other, so the
; consumer's composition root wires adapters in. `generation` and `testkit` sit
; outside the contract. Parenthesised layers are optional until they exist.

[importlinter]
root_package = rdf_persistence
include_external_packages = True

[importlinter:contract:layers]
name = Layers: entrypoints | adapters > services > domain
type = layers
layers =
    (rdf_persistence.entrypoints) | (rdf_persistence.adapters)
    (rdf_persistence.services)
    (rdf_persistence.domain)

[importlinter:contract:domain-pure]
name = domain imports no I/O, web, token or validation library
type = forbidden
source_modules =
    rdf_persistence.domain
forbidden_modules =
    httpx
    boto3
    fastapi
    jwt
    pyshacl
    anyio

[importlinter:contract:runtime-without-extras]
name = runtime layers import neither the testkit, the generators nor test tooling
; add rdf_persistence.entrypoints to source_modules when the package exists (stage 5)
type = forbidden
source_modules =
    rdf_persistence.domain
    rdf_persistence.services
    rdf_persistence.adapters
forbidden_modules =
    rdf_persistence.testkit
    rdf_persistence.generation
    pytest
    testcontainers
    linkml
