; =============================================================================
; Import Linter — architecture guardrails for RDF Persistence
; =============================================================================
; Run with:  make check-architecture   (wraps `uv run lint-imports`)
;
; Direction (PD-1, toolkit-v1-foundation):
;   entrypoints | adapters  >  services  >  domain
; Ports live in `services`; their implementations in `adapters`. `entrypoints`
; and `adapters` are independent siblings: neither imports the other, so the
; consumer's composition root wires adapters in. `testkit` sits outside the
; contract, and `rdf_persistence_generation` is a separate root package the
; library never imports (library-never-imports-the-generator). Parenthesised
; layers are optional until they exist.

[importlinter]
root_packages =
    rdf_persistence
    rdf_persistence_generation
    tests
    rdflib
include_external_packages = True

[importlinter:contract:layers]
name = Layers: entrypoints | adapters > services > domain
type = layers
layers =
    (rdf_persistence.entrypoints) | (rdf_persistence.adapters)
    (rdf_persistence.services)
    (rdf_persistence.domain)

; The thematic layout (thematic-structure PD-6). A stage adds its themes to `containers` and to
; `themes-ordered` (a theme not yet moved is absent, not empty); the old `layers` contract runs beside
; these until stage 7. `themes-ordered` lists the highest theme first.
[importlinter:contract:themes-layered]
name = Themes: in each theme, entrypoints | adapters > services > domain, and nothing outside the layers
type = layers
containers =
    rdf_persistence.core
    rdf_persistence.iris
    rdf_persistence.schema
    rdf_persistence.files
    rdf_persistence.provenance
    rdf_persistence.persistence
    rdf_persistence.migrations
    rdf_persistence.access
    rdf_persistence.tenancy
layers =
    (entrypoints) | (adapters)
    (services)
    (domain)
exhaustive = true

[importlinter:contract:themes-ordered]
name = Themes: a theme imports only the themes below it (core is the lowest)
type = layers
layers =
    rdf_persistence.tenancy
    rdf_persistence.access | rdf_persistence.migrations
    rdf_persistence.persistence
    rdf_persistence.provenance | rdf_persistence.files
    rdf_persistence.iris | rdf_persistence.schema
    rdf_persistence.core

[importlinter:contract:domain-of-a-theme-imports-no-upper-layer]
name = layers-across-themes (1/3) the domain of a theme imports no services, adapters or entrypoints of any theme
type = forbidden
source_modules =
    rdf_persistence.*.domain
forbidden_modules =
    rdf_persistence.*.services
    rdf_persistence.*.adapters
    rdf_persistence.*.entrypoints

[importlinter:contract:services-of-a-theme-import-no-adapters-or-entrypoints]
name = layers-across-themes (2/3) the services of a theme import no adapters or entrypoints of any theme
type = forbidden
source_modules =
    rdf_persistence.*.services
forbidden_modules =
    rdf_persistence.*.adapters
    rdf_persistence.*.entrypoints

[importlinter:contract:adapters-and-entrypoints-of-themes-are-independent]
name = layers-across-themes (3/3) the adapters and the entrypoints of the themes import neither the other
type = forbidden
source_modules =
    rdf_persistence.*.adapters
forbidden_modules =
    rdf_persistence.*.entrypoints

[importlinter:contract:entrypoints-of-themes-import-no-adapters]
name = layers-across-themes (3/3) the entrypoints of the themes import no adapters
type = forbidden
source_modules =
    rdf_persistence.*.entrypoints
forbidden_modules =
    rdf_persistence.*.adapters

; Temporary (thematic-structure D-13, D-16): while the unmoved modules stay at the old layout, no old
; contract or theme contract stops a moved theme from importing them. Every turned-on theme is a source
; here (a stage adds its themes, and `tests/unit/test_theme_contracts.py` fails when one is missing).
; Stage 7 removes this contract with the old layout.
[importlinter:contract:themes-never-import-the-old-layout]
name = a moved theme never imports the old layout (domain, services, adapters, entrypoints), until stage 7 removes it
type = forbidden
source_modules =
    rdf_persistence.core
    rdf_persistence.iris
    rdf_persistence.schema
    rdf_persistence.files
    rdf_persistence.provenance
    rdf_persistence.persistence
    rdf_persistence.migrations
    rdf_persistence.access
    rdf_persistence.tenancy
forbidden_modules =
    rdf_persistence.domain
    rdf_persistence.services
    rdf_persistence.adapters
    rdf_persistence.entrypoints

; Temporary (thematic-structure D-14): the other direction of the contract above. While the unmoved modules
; stay at the old layout, the old layers keep their order against the layers of the moved themes: an old
; layer never imports upward into a theme. `*` matches one segment, so `rdf_persistence.*.services` names
; `rdf_persistence.core.services` and not `rdf_persistence.services` (the old layer importing itself is
; fine). Stage 7 removes these four contracts with the old layout.
[importlinter:contract:old-domain-imports-no-theme-upper-layer]
name = old-vs-themes (1/4) old domain imports no theme upper layer
type = forbidden
source_modules =
    rdf_persistence.domain
forbidden_modules =
    rdf_persistence.*.services
    rdf_persistence.*.adapters
    rdf_persistence.*.entrypoints

[importlinter:contract:old-services-import-no-theme-adapters-or-entrypoints]
name = old-vs-themes (2/4) old services import no theme adapters or entrypoints
type = forbidden
source_modules =
    rdf_persistence.services
forbidden_modules =
    rdf_persistence.*.adapters
    rdf_persistence.*.entrypoints

[importlinter:contract:old-adapters-import-no-theme-entrypoints]
name = old-vs-themes (3/4) old adapters import no theme entrypoints
type = forbidden
source_modules =
    rdf_persistence.adapters
forbidden_modules =
    rdf_persistence.*.entrypoints

[importlinter:contract:old-entrypoints-import-no-theme-adapters]
name = old-vs-themes (4/4) old entrypoints import no theme adapters
type = forbidden
source_modules =
    rdf_persistence.entrypoints
forbidden_modules =
    rdf_persistence.*.adapters

; Technical models (service settings, wire shapes) are generated outside the domain and the domain never
; imports them, directly or through a chain (technical-models PD-2, Q-2). The `thematic-structure` change
; replaces this contract with one over the thematic layout.
[importlinter:contract:domain-never-imports-technical-models]
name = the domain never imports a technical model (service, wire or testkit)
type = forbidden
source_modules =
    rdf_persistence.domain
    rdf_persistence.*.domain
forbidden_modules =
    rdf_persistence.services.generated
    rdf_persistence.adapters.generated
    rdf_persistence.*.services.generated
    rdf_persistence.*.adapters.generated
    rdf_persistence.testkit.generated

[importlinter:contract:domain-pure]
name = domain imports no I/O, web, token or validation library
type = forbidden
source_modules =
    rdf_persistence.domain
    rdf_persistence.*.domain
forbidden_modules =
    httpx
    boto3
    fastapi
    jwt
    pyshacl
    anyio

[importlinter:contract:runtime-without-extras]
name = runtime layers import neither the testkit, the generators nor test tooling
type = forbidden
source_modules =
    rdf_persistence.domain
    rdf_persistence.services
    rdf_persistence.adapters
    rdf_persistence.entrypoints
    rdf_persistence.*.domain
    rdf_persistence.*.services
    rdf_persistence.*.adapters
    rdf_persistence.*.entrypoints
forbidden_modules =
    rdf_persistence.testkit
    rdf_persistence_generation
    pytest
    testcontainers
    linkml

[importlinter:contract:works-without-the-generate-extra]
name = what runs without the generate extra imports no linkml (only linkml_runtime)
; The freshness plugin, the manifest comparison, the configuration and the schema helpers are
; installed with the base package; the generators (the `generate` extra) are reached only through
; the lazy import in cli.py, which is ignored here so every other chain is checked.
type = forbidden
source_modules =
    rdf_persistence_generation.cli
    rdf_persistence_generation.config
    rdf_persistence_generation.manifest
    rdf_persistence_generation.pipeline
    rdf_persistence_generation.exceptions
    rdf_persistence_generation.problems
    rdf_persistence_generation.generated
    rdf_persistence_generation.testkit
    rdf_persistence.testkit
    rdf_persistence.schema.services.schema
    rdf_persistence.schema.services.schema_structure
forbidden_modules =
    linkml
ignore_imports =
    rdf_persistence_generation.cli -> rdf_persistence_generation.steps

; The library never imports the generator (generator-package PD-8, DEC-3). The only edges are the four
; shims that keep the old `rdf_persistence.testkit.*` import paths alive, each re-exporting its
; generator-side module.
[importlinter:contract:library-never-imports-the-generator]
name = the library never imports the generator, but through the four testkit shims
type = forbidden
source_modules =
    rdf_persistence
forbidden_modules =
    rdf_persistence_generation
ignore_imports =
    rdf_persistence.testkit.freshness -> rdf_persistence_generation.testkit.freshness
    rdf_persistence.testkit.conformance -> rdf_persistence_generation.testkit.conformance
    rdf_persistence.testkit.roundtrip -> rdf_persistence_generation.testkit.roundtrip
    rdf_persistence.testkit.strategies -> rdf_persistence_generation.testkit.strategies

[importlinter:contract:collaboration-layers]
name = the collaboration modules layer above the session: messagebus > collaboration > transitions | write_guards > discussion | reference_collections | workflows > access > session (PD-28, PD-32)
; access sits above session, not beside it: it reaches the session through the mapper (access -> mapper -> session).
type = layers
layers =
    rdf_persistence.services.messagebus
    rdf_persistence.services.collaboration
    rdf_persistence.services.transitions | rdf_persistence.services.write_guards
    rdf_persistence.services.discussion | rdf_persistence.services.reference_collections | rdf_persistence.services.workflows
    rdf_persistence.access.services.access
    rdf_persistence.persistence.services.session

[importlinter:contract:session-and-provenance-without-mapper]
name = the session and the activity shape never import the mapper, which imports the session (message-bus PD-6)
type = forbidden
source_modules =
    rdf_persistence.persistence.services.session
    rdf_persistence.provenance.services.provenance
forbidden_modules =
    rdf_persistence.persistence.services.mapper

[importlinter:contract:tenancy-without-the-runner]
name = the tenancy never imports the runner, which imports the tenancy (PD-24.2, PD-25.6)
type = forbidden
source_modules =
    rdf_persistence.tenancy.services.tenancy
forbidden_modules =
    rdf_persistence.tenancy.services.migration_runner

[importlinter:contract:nothing-in-services-imports-the-bus]
name = no other services module imports the message bus, which sits above them (message-bus PD-13)
; Each module is named, as a package source would share the bus as a descendant: a new services module joins this list.
type = forbidden
source_modules =
    rdf_persistence.access.services.access
    rdf_persistence.services.aggregates
    rdf_persistence.core.services.artifacts
    rdf_persistence.services.collaboration
    rdf_persistence.services.components
    rdf_persistence.persistence.services.decoding
    rdf_persistence.services.discussion
    rdf_persistence.services.documents
    rdf_persistence.services.event_hub
    rdf_persistence.services.event_stream
    rdf_persistence.services.events
    rdf_persistence.services.file_removal
    rdf_persistence.files.services.files
    rdf_persistence.access.services.identity
    rdf_persistence.tenancy.services.iri_policy_guard
    rdf_persistence.iris.services.iris
    rdf_persistence.persistence.services.listing
    rdf_persistence.persistence.services.loading
    rdf_persistence.persistence.services.mapper
    rdf_persistence.tenancy.services.migration_runner
    rdf_persistence.migrations.services.migrations
    rdf_persistence.provenance.services.provenance
    rdf_persistence.services.reference_collections
    rdf_persistence.services.relay
    rdf_persistence.schema.services.schema
    rdf_persistence.schema.services.schema_structure
    rdf_persistence.persistence.services.session
    rdf_persistence.persistence.services.store
    rdf_persistence.tenancy.services.sweep
    rdf_persistence.tenancy.services.tenancy
    rdf_persistence.tenancy.services.tenant_dump
    rdf_persistence.tenancy.services.tenant_move
    rdf_persistence.tenancy.services.tenant_sweep
    rdf_persistence.core.services.telemetry
    rdf_persistence.access.services.tokens
    rdf_persistence.services.transitions
    rdf_persistence.persistence.services.unique_keys
    rdf_persistence.provenance.services.visible_part
    rdf_persistence.schema.services.vocabulary
    rdf_persistence.services.workflows
    rdf_persistence.services.write_guards
    rdf_persistence.core.services.yaml_files
forbidden_modules =
    rdf_persistence.services.messagebus

[importlinter:contract:event-bus-libraries-in-one-module]
name = only the Redis adapter imports faststream or redis (aggregate-events PD-8)
type = forbidden
source_modules =
    rdf_persistence
    rdf_persistence_generation
forbidden_modules =
    faststream
    redis
ignore_imports =
    rdf_persistence.adapters.redis_events -> faststream

[importlinter:contract:domain-tests-stay-in-the-domain]
name = the domain tests import nothing above the domain: no services, adapters, entrypoints, testkit or toy service
; Direct imports only: the package's public names (`from rdf_persistence import ...`) reach the upper layers in
; the package's own __init__, which the domain tests may use.
type = forbidden
allow_indirect_imports = True
source_modules =
    tests.unit.domain
    tests.unit.core.test_rp_model
    tests.unit.core.test_exceptions
    tests.unit.core.test_sparql
    tests.unit.core.test_sparql_parsing
    tests.unit.iris.test_layout
    tests.unit.files.test_blob_keys
forbidden_modules =
    rdf_persistence.services
    rdf_persistence.adapters
    rdf_persistence.entrypoints
    rdf_persistence.*.services
    rdf_persistence.*.adapters
    rdf_persistence.*.entrypoints
    rdf_persistence.testkit
    tests.toy
    tests.toy_service

[importlinter:contract:sparql-parser-only-through-the-wrappers]
name = nothing imports rdflib.plugins.sparql or pyshacl but the wrappers
; rdflib is a root package above, so its submodules can be named; indirect chains through rdflib itself
; are fine, only a direct import counts.
type = forbidden
allow_indirect_imports = True
source_modules =
    rdf_persistence
    rdf_persistence_generation
forbidden_modules =
    rdflib.plugins.sparql
    pyshacl
ignore_imports =
    rdf_persistence.core.domain.sparql_parsing -> rdflib.plugins.sparql
    rdf_persistence.core.domain.sparql_parsing -> rdflib.plugins.sparql.**
    rdf_persistence.services.shacl -> pyshacl
