+# What a relative IRI in a request resolves against, as Fuseki resolves it against the server's base.
+BASE_IRI = "http://fake.invalid/"
+N_TRIPLES = "application/n-triples"
+RESULTS_JSON = "application/sparql-results+json"
+
+
+_NOT_IN_NOTHING = re.compile(r"\bNOT\s+IN\s*\(\s*\)", re.IGNORECASE)
+
+
+def _not_in_none(sparql: str) -> str:
+    # shortcut: pyoxigraph evaluates `?x NOT IN ()` as an error, so the filter drops every row; the
+    # SPARQL spec makes it true. An IRI nothing holds says the same. Drop it when pyoxigraph is fixed.
+    return _NOT_IN_NOTHING.sub("NOT IN (<urn:x-fake:nothing>)", sparql)
+
+
+def _format(media_type: str) -> RdfFormat:
+    found = RdfFormat.from_media_type(media_type)
+    assert found is not None, media_type
+    return found
+
+
+def _as_result(answer: QuerySolutions | QueryBoolean | QueryTriples) -> Result:
+    """An rdflib ``Result`` of a pyoxigraph answer, shaped as the Fuseki adapter reads it."""
+    if isinstance(answer, QueryTriples):
+        result = Result("CONSTRUCT")
+        result.graph = Graph().parse(data=answer.serialize(format=_format(N_TRIPLES)), format=N_TRIPLES)
+        return result
+    body = answer.serialize(format=QueryResultsFormat.JSON)
+    return Result.parse(BytesIO(body), format=RESULTS_JSON)
+
