{
   "@context": {
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "ODRL": "http://www.w3.org/ns/odrl/2/",
      "bibo": "http://purl.org/ontology/bibo/",
      "dcterms": "http://purl.org/dc/terms/",
      "formats": "http://www.w3.org/ns/formats/",
      "lib": "https://example.org/ns/library#",
      "linkml": "https://w3id.org/linkml/",
      "prov": "http://www.w3.org/ns/prov#",
      "rp": "https://meaningfy.ws/ns/rdf-persistence#",
      "schema": "http://schema.org/",
      "shex": "http://www.w3.org/ns/shex#",
      "skos": "http://www.w3.org/2004/02/skos/core#",
      "@vocab": "https://example.org/ns/library#",
      "action": {
         "@id": "ODRL:action",
         "@type": "@vocab",
         "@context": {
            "read": "http://www.w3.org/ns/odrl/2/read",
            "modify": "http://www.w3.org/ns/odrl/2/modify",
            "delete": "http://www.w3.org/ns/odrl/2/delete",
            "administer": "https://meaningfy.ws/ns/rdf-persistence#administer"
         }
      },
      "actions": {
         "@container": "@set",
         "@id": "rp:permits",
         "@type": "@vocab",
         "@context": {
            "read": "http://www.w3.org/ns/odrl/2/read",
            "modify": "http://www.w3.org/ns/odrl/2/modify",
            "delete": "http://www.w3.org/ns/odrl/2/delete",
            "administer": "https://meaningfy.ws/ns/rdf-persistence#administer"
         }
      },
      "assignee": {
         "@type": "@id",
         "@id": "ODRL:assignee"
      },
      "authors": {
         "@container": "@set",
         "@id": "schema:author"
      },
      "blobs": {
         "@container": "@set",
         "@id": "rp:sweptBlob"
      },
      "byte_size": {
         "@id": "rp:byteSize"
      },
      "chapters": {
         "@type": "@id",
         "@container": "@set",
         "@id": "chapter"
      },
      "city": {
         "@id": "schema:addressLocality"
      },
      "id": "@id",
      "contributor": {
         "@type": "@id",
         "@container": "@set",
         "@id": "dcterms:contributor"
      },
      "created": {
         "@type": "xsd:dateTime",
         "@id": "dcterms:created"
      },
      "creator": {
         "@type": "@id",
         "@id": "dcterms:creator"
      },
      "description": {
         "@id": "dcterms:description"
      },
      "file_name": {
         "@id": "rp:fileName"
      },
      "genre": {
         "@id": "schema:genre",
         "@type": "@vocab",
         "@context": {
            "fiction": "http://schema.org/Fiction",
            "nonfiction": "http://schema.org/NonFiction",
            "poetry": "http://schema.org/Poetry"
         }
      },
      "grants": {
         "@type": "@id",
         "@container": "@set",
         "@id": "rp:grant"
      },
      "graph": {
         "@type": "@id",
         "@id": "rp:graph"
      },
      "isbn": {
         "@id": "bibo:isbn"
      },
      "kind": {
         "@id": "rp:kind",
         "@type": "@vocab",
         "@context": {
            "aggregate": "https://meaningfy.ws/ns/rdf-persistence#Aggregate",
            "loaded_graph": "https://meaningfy.ws/ns/rdf-persistence#LoadedGraph"
         }
      },
      "label": {
         "@id": "skos:prefLabel"
      },
      "level": {
         "@id": "rp:level",
         "@type": "@vocab",
         "@context": {
            "system": "https://meaningfy.ws/ns/rdf-persistence#SystemLevel",
            "tenant": "https://meaningfy.ws/ns/rdf-persistence#TenantLevel",
            "aggregate": "https://meaningfy.ws/ns/rdf-persistence#AggregateLevel"
         }
      },
      "listed_in": {
         "@type": "@id",
         "@id": "rp:listedIn"
      },
      "loaded_at": {
         "@type": "xsd:dateTime",
         "@id": "rp:loadedAt"
      },
      "loaded_graph": {
         "@type": "@id",
         "@id": "rp:loadedGraph"
      },
      "loaded_graphs": {
         "@type": "@id",
         "@container": "@set",
         "@id": "rp:sweptLoadedGraph"
      },
      "media_type": {
         "@id": "rp:mediaType"
      },
      "modified": {
         "@type": "xsd:dateTime",
         "@id": "dcterms:modified"
      },
      "shade": {
         "@id": "shade"
      },
      "notes": {
         "@type": "@id",
         "@container": "@set",
         "@id": "note"
      },
      "number": {
         "@id": "bibo:chapter"
      },
      "older_than_seconds": {
         "@id": "rp:olderThanSeconds"
      },
      "owned_by": {
         "@type": "@id",
         "@id": "rp:ownedBy"
      },
      "prohibitions": {
         "@type": "@id",
         "@container": "@set",
         "@id": "rp:prohibition"
      },
      "published": {
         "@type": "xsd:date",
         "@id": "dcterms:issued"
      },
      "removed_blobs": {
         "@id": "rp:removedBlobs"
      },
      "removed_loaded_graphs": {
         "@id": "rp:removedLoadedGraphs"
      },
      "role": {
         "@id": "rp:role"
      },
      "scan_of": {
         "@type": "@id",
         "@id": "schema:exampleOfWork"
      },
      "sha256": {
         "@id": "rp:sha256"
      },
      "skipped_blobs": {
         "@container": "@set",
         "@id": "rp:skippedBlob"
      },
      "started_at": {
         "@type": "xsd:dateTime",
         "@id": "rp:startedAt"
      },
      "state": {
         "@id": "rp:state",
         "@type": "@vocab",
         "@context": {
            "active": "https://meaningfy.ws/ns/rdf-persistence#Active",
            "deleting": "https://meaningfy.ws/ns/rdf-persistence#Deleting"
         }
      },
      "target": {
         "@type": "@id",
         "@id": "ODRL:target"
      },
      "tenant": {
         "@type": "@id",
         "@id": "rp:tenant"
      },
      "text": {
         "@id": "schema:text"
      },
      "uploaded": {
         "@type": "xsd:dateTime",
         "@id": "dcterms:dateSubmitted"
      },
      "uploaded_by": {
         "@type": "@id",
         "@id": "rp:uploadedBy"
      },
      "url_segment": {
         "@id": "rp:urlSegment"
      },
      "version": {
         "@id": "rp:version"
      },
      "@version": 1.1,
      "type": "@type",
      "AggregateRoot": {
         "@id": "rp:AggregateRoot"
      },
      "BlobEntry": {
         "@id": "rp:BlobEntry"
      },
      "Book": {
         "@id": "bibo:Book"
      },
      "Chapter": {
         "@id": "bibo:Chapter"
      },
      "CommitMarker": {
         "@id": "rp:CommitMarker"
      },
      "Described": {
         "@id": "rp:Described"
      },
      "Grant": {
         "@id": "ODRL:Permission"
      },
      "Library": {
         "@id": "schema:Library"
      },
      "LibraryAccess": {
         "@id": "LibraryAccess"
      },
      "Note": {
         "@id": "Note"
      },
      "PendingLoad": {
         "@id": "rp:PendingLoad"
      },
      "Policy": {
         "@id": "ODRL:Set"
      },
      "Principal": {
         "@id": "prov:Agent"
      },
      "Prohibition": {
         "@id": "ODRL:Prohibition"
      },
      "RegistryEntry": {
         "@id": "rp:RegistryEntry"
      },
      "RoleDefinition": {
         "@id": "rp:RoleDefinition"
      },
      "Rule": {
         "@id": "ODRL:Rule"
      },
      "Scan": {
         "@id": "Scan"
      },
      "StoredFile": {
         "@id": "rp:StoredFile"
      },
      "TenantAccess": {
         "@id": "rp:TenantAccess"
      },
      "TenantLabelled": {
         "@id": "rp:TenantLabelled"
      },
      "TenantSweepReport": {
         "@id": "rp:TenantSweepReport"
      },
      "Tracked": {
         "@id": "rp:Tracked"
      }
   }
}
