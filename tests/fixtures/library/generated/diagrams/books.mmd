classDiagram
    class Book {
        <<root>>
        +string isbn
        +List~string~ authors
        +date published
        +Genre genre
    }
    class Shelf {
        <<root>>
    }
    class Chapter {
        <<owned>>
        +integer number
    }
    class Note {
        <<owned>>
        +string text
        +string shade
    }
    Book "1" *-- "*" Chapter : chapters
    Book "1" --> "0..1" Shelf : shelf
    Book "1" --> "0..1" Book : sequel_of
    Chapter "1" *-- "*" Note : notes
    Note "1" --> "0..1" Book : about
