{
  "@context": "context.jsonld",
  "@omitGraph": true,
  "@embed": "@always",
  "@omitDefault": true,
  "@type": "Shelf",
  "creator": {
    "@embed": "@never",
    "@omitDefault": true
  },
  "contributor": {
    "@embed": "@never",
    "@omitDefault": true
  },
  "membership_rule": {
    "@embed": "@always",
    "@omitDefault": true,
    "@type": "MembershipRule",
    "rule_equalities": {
      "@embed": "@always",
      "@omitDefault": true,
      "@type": "SlotEquality"
    }
  }
}
