lib:Book a sh:NodeShape ;
	rdfs:comment "A book held by a library; an aggregate root that owns its chapters." ;
	rdfs:label "Book" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n52 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n110 , _:c14n111 , _:c14n114 , _:c14n119 , _:c14n120 , _:c14n29 , _:c14n42 , _:c14n43 , _:c14n5 , _:c14n62 , _:c14n8 , _:c14n80 ;
	sh:targetClass <http://purl.org/ontology/bibo/Book> .
lib:Chapter a sh:NodeShape ;
	rdfs:comment "A chapter of a book, known by its number rather than a label; part of the book's aggregate. It owns its notes." ;
	rdfs:label "Chapter" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n117 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n112 , _:c14n113 , _:c14n20 , _:c14n59 , _:c14n7 ;
	sh:targetClass <http://purl.org/ontology/bibo/Chapter> .
lib:Library a sh:NodeShape ;
	rdfs:comment "A library; the tenant root. Its IRI is the tenant IRI and it lives in the tenant's meta graph." ;
	rdfs:label "Library" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n118 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n104 , _:c14n107 , _:c14n108 , _:c14n11 , _:c14n38 , _:c14n49 , _:c14n61 , _:c14n82 ;
	sh:targetClass <http://schema.org/Library> .
lib:LibraryAccess a sh:NodeShape ;
	rdfs:comment "The access record of a library tenant; its grants are the metamodel's." ;
	rdfs:label "Library access" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n93 ;
