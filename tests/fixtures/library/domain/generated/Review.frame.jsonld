{
  "@context": "context.jsonld",
  "@omitGraph": true,
  "@embed": "@always",
  "@omitDefault": true,
  "@type": "Review",
  "creator": {
    "@embed": "@never",
    "@omitDefault": true
  },
  "contributor": {
    "@embed": "@never",
    "@omitDefault": true
  },
  "was_associated_with": {
    "@embed": "@never",
    "@omitDefault": true
  },
  "generations": {
    "@embed": "@always",
    "@omitDefault": true,
    "@type": "Generation"
  },
  "invalidations": {
    "@embed": "@always",
    "@omitDefault": true,
    "@type": "Invalidation"
  }
}
