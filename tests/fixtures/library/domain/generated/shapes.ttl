rp:UnderWorkflow a sh:NodeShape ;
	rdfs:comment "A mixin for an aggregate root that follows a workflow, which its class names with the workflow annotation. It gives the root its current state, which only a transition changes, and, under an assignable workflow, its assignees, which only an assignment or a clearing transition changes." ;
	rdfs:label "Under workflow" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n67 ;
