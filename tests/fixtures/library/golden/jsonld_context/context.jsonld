      },
      "Prohibition": {
         "@id": "ODRL:Prohibition"
      },
      "RegistryEntry": {
         "@id": "rp:RegistryEntry"
      },
      "RoleDefinition": {
         "@id": "rp:RoleDefinition"
      },
      "Rule": {
         "@id": "ODRL:Rule"
      },
      "Scan": {
         "@id": "Scan"
      },
      "StoredFile": {
         "@id": "rp:StoredFile"
      },
      "TenantAccess": {
         "@id": "rp:TenantAccess"
      },
      "Tracked": {
         "@id": "rp:Tracked"
      }
   }
}
