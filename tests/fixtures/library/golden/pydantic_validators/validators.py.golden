)

from pydantic import (
    BaseModel as _BaseModel,
    ConfigDict as _ConfigDict,
    Field as _Field,
    RootModel as _RootModel,
    SerializationInfo as _SerializationInfo,
    SerializerFunctionWrapHandler as _SerializerFunctionWrapHandler,
    field_validator,
    model_serializer,
    model_validator
)


metamodel_version = "1.12.0"
version = "None"


from rdf_persistence import RpModel as ConfiguredBaseModel

linkml_meta = None


class Contact(ConfiguredBaseModel):
    "A contact reachable by exactly one of mail and phone."
    mail: _Optional[str] = _Field(default=None, title="Mail", description="The mail address.")
    phone: _Optional[str] = _Field(default=None, title="Phone", description="The phone number.")

    @model_validator(mode="after")
    def exactly_one_of_Contact(self) -> "Contact":
        held = [
            label
            for label, present in (
                ("mail present", self.mail not in (None, [])),
                ("phone present", self.phone not in (None, [])),
            )
            if present
        ]
        if len(held) != 1:
            raise ValueError(
                "Contact: exactly_one_of needs exactly one of [mail present, phone present], but "
                + str(held or "none")
                + " hold"
            )
        return self


class Customer(Contact):
    "A contact that is also a customer."
    account: _Optional[str] = _Field(default=None, title="Account", description="The account number.")
    mail: _Optional[str] = _Field(default=None, title="Mail", description="The mail address.")
    phone: _Optional[str] = _Field(default=None, title="Phone", description="The phone number.")


class Reach(ConfiguredBaseModel):
    "A way to reach somebody by at least one of mail and phone."
    mail: _Optional[str] = _Field(default=None, title="Mail", description="The mail address.")
    phone: _Optional[str] = _Field(default=None, title="Phone", description="The phone number.")

    @model_validator(mode="after")
    def any_of_Reach(self) -> "Reach":
        held = [
            label
            for label, present in (
                ("mail present", self.mail not in (None, [])),
                ("phone present", self.phone not in (None, [])),
            )
            if present
        ]
        if not held:
            raise ValueError(
                "Reach: any_of needs at least one of [mail present, phone present], but "
                + str(held or "none")
                + " hold"
            )
        return self


class Entry(ConfiguredBaseModel):
    "A ledger entry, one per name and tag."
    name: _Optional[str] = _Field(default=None, title="Name", description="The name of the entry.")
    tag: _Optional[str] = _Field(default=None, title="Tag", description="The tag of the entry.")


class Ledger(ConfiguredBaseModel):
    "Entries and the people who care about them."
    entries: _Optional[list[Entry]] = _Field(default=None, title="Entries", description="The entries.")
    watchers: _Optional[list[str]] = _Field(default=None, title="Watchers", description="The names of those who watch.")

    @model_validator(mode="after")
    def unique_keys_entries_entry_key(self) -> "Ledger":
        seen: set[str] = set()
        repeated: list[tuple] = []
        for item in self.entries or []:
            key = (item.name, item.tag,)
            if repr(key) in seen:
                repeated.append(key)
            seen.add(repr(key))
        if repeated:
            raise ValueError(
                "Ledger.entries: unique_keys entry_key (name, tag) repeated by "
                + str(repeated)
            )
        return self


class Archive(Ledger):
    "A ledger that is kept."
    entries: _Optional[list[Entry]] = _Field(default=None, title="Entries", description="The entries.")
    watchers: _Optional[list[str]] = _Field(default=None, title="Watchers", description="The names of those who watch.")


# Model rebuild
