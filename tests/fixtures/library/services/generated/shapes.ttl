<https://meaningfy.ws/ns/rdf-persistence#AggregateKey> a sh:NodeShape ;
	rdfs:comment "A key across aggregates, as the runtime reads it from the schema: no two aggregate roots of one class in a tenant's database hold the same values for its predicates." ;
	rdfs:label "Aggregate key" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n2 ;
	sh:property _:c14n10 , _:c14n14 , _:c14n25 , _:c14n28 ;
	sh:targetClass <https://meaningfy.ws/ns/rdf-persistence#AggregateKey> .
<https://meaningfy.ws/ns/rdf-persistence#AggregateRoot> a sh:NodeShape ;
	rdfs:comment "A mixin for classes whose instances are aggregate roots. Each instance is one named graph, whose IRI is derived from the root's IRI; it is versioned, loaded and saved as a whole." ;
	rdfs:label "Aggregate root" ;
	sh:closed false ;
	sh:ignoredProperties _:c14n23 ;
	sh:targetClass <https://meaningfy.ws/ns/rdf-persistence#AggregateRoot> .
<https://meaningfy.ws/ns/rdf-persistence#CommitMarker> a sh:NodeShape ;
	rdfs:comment "The registry marker of one transaction's commit: a fresh IRI per transaction, written first in the single request, so the writes that follow apply only if it was written." ;
	rdfs:label "Commit marker" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n16 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n11 ;
	sh:targetClass <https://meaningfy.ws/ns/rdf-persistence#CommitMarker> .
<https://meaningfy.ws/ns/rdf-persistence#KeyDuplicate> a sh:NodeShape ;
	rdfs:comment "A set of aggregate roots of one class that hold the same values for a key across aggregates, found in a tenant's database by the duplicates report." ;
	rdfs:label "Key duplicate" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n7 ;
	sh:property _:c14n13 , _:c14n21 , _:c14n6 , _:c14n8 ;
	sh:targetClass <https://meaningfy.ws/ns/rdf-persistence#KeyDuplicate> .
<https://meaningfy.ws/ns/rdf-persistence#PendingLoad> a sh:NodeShape ;
	rdfs:comment "The registry marker of a load not yet committed: one triple saying when the graph was put. It names no registry entry, so deleting it never deletes an entry." ;
	rdfs:label "Pending load" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n15 ;
	sh:nodeKind sh:IRI ;
	sh:property _:c14n18 ;
	sh:targetClass <https://meaningfy.ws/ns/rdf-persistence#PendingLoad> .
<https://meaningfy.ws/ns/rdf-persistence#Principal> a sh:NodeShape ;
	rdfs:comment "A reference to a user account in the identity provider, by IRI only." ;
	rdfs:label "Principal" ;
	sh:closed true ;
	sh:ignoredProperties _:c14n30 ;
	sh:nodeKind sh:IRI ;
	sh:targetClass prov:Agent .
<https://meaningfy.ws/ns/rdf-persistence#RegistryEntry> a sh:NodeShape ;
	rdfs:comment "An entry of a tenant's registry graph, naming a graph that belongs to an aggregate. It is written by the session, never by the application." ;
	rdfs:label "Registry entry" ;
