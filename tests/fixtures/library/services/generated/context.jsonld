{
   "@context": {
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "lib": "https://example.org/ns/library#",
      "linkml": "https://w3id.org/linkml/",
      "schema": "http://schema.org/",
      "shex": "http://www.w3.org/ns/shex#",
      "skos": "http://www.w3.org/2004/02/skos/core#",
      "@vocab": "https://example.org/ns/library#",
      "check_findings": {
         "@type": "@id",
         "@container": "@set",
         "@id": "checkFindings"
      },
      "check_status": {
         "@id": "checkStatus",
         "@type": "@vocab",
         "@context": {
            "ok": "https://example.org/ns/library#LoanStatusOk",
            "overdue": "https://example.org/ns/library#LoanStatusOverdue"
         }
      },
      "checks": {
         "@type": "@id",
         "@container": "@set",
         "@id": "checks"
      },
      "finding_code": {
         "@id": "findingCode"
      },
      "finding_message": {
         "@id": "findingMessage"
      },
      "@version": 1.1,
      "type": "@type",
      "LoanCheck": {
         "@id": "LoanCheck"
      },
      "LoanChecksResponse": {
         "@id": "LoanChecksResponse"
      },
      "LoanFinding": {
         "@id": "LoanFinding"
      }
   }
}
