{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/no_polling.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\" || exit 0"
          }
        ]
      }
    ]
  }
}
