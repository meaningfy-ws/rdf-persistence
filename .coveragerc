# coverage.py configuration — renders to .coveragerc at the repo root.
# No-src layout: measure the top-level package directly.
[run]
branch = True
source =
    rdf_persistence
    rdf_persistence_generation
# The adapters are under the floor: their unit tests use fakes of the remote side. Only the two
# modules that need a real container (PD-16) stay outside it; `make test-containers` covers them.
omit =
    rdf_persistence/events/adapters/redis_events.py
    rdf_persistence/testkit/containers/*

[report]
fail_under = 80
show_missing = true
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    ^\s+\.\.\.$
    def __repr__
    raise NotImplementedError
