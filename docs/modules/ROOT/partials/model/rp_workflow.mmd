classDiagram
    class Workflow {
        +uri id
        +string workflow_name
        +List~string~ workflow_states
        +string initial_state
        +boolean assignable
    }
    class WorkflowTransition {
        <<owned>>
        +string from_state
        +string to_state
        +List~string~ transition_roles
        +boolean comment_required
        +boolean clears_assignees
    }
    class Transition {
        +uri used_resource
        +uri from_state_iri
        +uri to_state_iri
        +uri transition_comment
        +string to_state
        +string expected_version
        +string body_value
    }
    class Assignment {
        +uri used_resource
        +string expected_version
    }
    class Activity
    class Principal
    Workflow "1" *-- "*" WorkflowTransition : workflow_transitions
    Transition "1" --> "*" Principal : released_principals
    Activity <|-- Transition
    Assignment "1" --> "*" Principal : assigned_principals
    Assignment "1" --> "*" Principal : released_principals
    Assignment "1" --> "*" Principal : assigned_to
    Activity <|-- Assignment
